@{ ViewData["Title"] = "EUREKABANK RESTful · Ingreso"; }
<link rel="stylesheet" href="~/css/eureka.css" />
<main class="login-page"><section class="login-card"><div class="brand"><img src="~/images/logo.png" alt="EurekaBank RESTful" width="38" height="38" style="object-fit:contain" /><div><b>EUREKABANK</b><small>Banca digital RESTful</small></div></div><h1>Tu dinero, en movimiento.</h1><p>Ingresa para consultar y operar tus cuentas con tranquilidad.</p><form method="post" class="login-form"><label>Usuario</label><input class="field" name="userName" required /><label>Contraseña</label><input class="field" name="password" type="password" required /><p class="error">@ViewBag.Error</p><button class="primary">Ingresar a mi banca</button></form><footer>Protegido por sesiones seguras · EUREKABANK RESTful</footer></section></main>
