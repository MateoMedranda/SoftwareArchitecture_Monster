<ContentPage x:Class="EurekaBank.Mobile.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F1F7FB"
             Title="EUREKABANK RESTful">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="14">

            <!-- Inicio de sesión -->
            <Frame x:Name="LoginCard" BackgroundColor="White" CornerRadius="24" Padding="26">
                <VerticalStackLayout Spacing="12">
                    <Image Source="logo.jpg"
                           HeightRequest="86"
                           WidthRequest="86"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="EUREKABANK RESTful"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#123A5A"
                           HorizontalOptions="Center" />
                    <Label Text="Tu banca RESTful, siempre contigo"
                           HorizontalOptions="Center"
                           TextColor="#597083" />
                    <Entry x:Name="UserName" Placeholder="Usuario" />
                    <Entry x:Name="Password" Placeholder="Contraseña" IsPassword="True" />
                    <ActivityIndicator x:Name="LoginBusy"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="#23689B"
                                       HorizontalOptions="Center" />
                    <Label x:Name="LoginStatus" TextColor="#BD4253" />
                    <Button x:Name="LoginButton"
                            Text="Ingresar a mi banca"
                            Clicked="SignIn"
                            BackgroundColor="#23689B"
                            TextColor="White"
                            CornerRadius="10" />
                    <Button x:Name="ServerButton"
                            Text="Servidor"
                            Clicked="ShowServerSettings"
                            BackgroundColor="Transparent"
                            TextColor="#597083"
                            FontSize="12"
                            HeightRequest="28"
                            Padding="0" />
                    <Frame x:Name="ServerSettings"
                           IsVisible="False"
                           BackgroundColor="#F5FAFD"
                           BorderColor="#CFE0EA"
                           Padding="14"
                           CornerRadius="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Servidor REST" FontAttributes="Bold" TextColor="#123A5A" />
                            <Label Text="Emulador local: http://10.0.2.2:62558/api/v1"
                                   FontSize="11"
                                   TextColor="#597083" />
                            <Entry x:Name="EndpointEntry"
                                   Placeholder="http://10.0.2.2:62558/api/v1"
                                   Keyboard="Url"
                                   ClearButtonVisibility="WhileEditing" />
                            <Label x:Name="ServerStatus" FontSize="12" TextColor="#087D55" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Text="Cancelar"
                                        Clicked="CancelServerSettings"
                                        BackgroundColor="White"
                                        TextColor="#23689B"
                                        BorderColor="#B9CFDE"
                                        BorderWidth="1"
                                        CornerRadius="9" />
                                <Button Grid.Column="1"
                                        Text="Guardar"
                                        Clicked="SaveServerSettings"
                                        BackgroundColor="#23689B"
                                        TextColor="White"
                                        CornerRadius="9" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Banca autenticada -->
            <VerticalStackLayout x:Name="Dashboard" IsVisible="False" Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="2,0">
                    <Image Grid.Column="0" Source="logo.jpg" WidthRequest="34" HeightRequest="34" Aspect="AspectFit" Margin="0,0,9,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label x:Name="Welcome" FontSize="18" FontAttributes="Bold" TextColor="#123A5A" />
                        <Label Text="Banca digital segura" FontSize="11" TextColor="#597083" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="Salir"
                            Clicked="SignOut"
                            BackgroundColor="White"
                            TextColor="#23689B"
                            BorderColor="#B9CFDE"
                            BorderWidth="1"
                            CornerRadius="9"
                            HeightRequest="34"
                            Padding="12,0" />
                </Grid>

                <ScrollView Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Resumen" CommandParameter="SUMMARY" Clicked="Navigate" />
                        <Button Text="Movimientos" CommandParameter="MOVEMENTS" Clicked="Navigate" />
                        <Button Text="Transferir" CommandParameter="TRANSFER" Clicked="Navigate" />
                        <HorizontalStackLayout x:Name="StaffNavigation" IsVisible="False" Spacing="8">
                            <Button Text="Operar" CommandParameter="OPERATIONS" Clicked="Navigate" />
                            <Button Text="Cuentas" CommandParameter="ACCOUNTS" Clicked="Navigate" />
                        </HorizontalStackLayout>
                        <Button Text="Perfil" CommandParameter="PROFILE" Clicked="Navigate" />
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Resumen -->
                <VerticalStackLayout x:Name="SummarySection" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Mis cuentas" FontSize="25" FontAttributes="Bold" TextColor="#123A5A" />
                            <Label Text="Consulta tus saldos y cuentas disponibles." TextColor="#597083" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="↻" Clicked="RefreshAccounts" BackgroundColor="White" TextColor="#23689B" />
                    </Grid>
                    <CollectionView x:Name="Accounts" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="14" Margin="0,4" Padding="18">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Number, StringFormat='Cuenta {0}'}" FontAttributes="Bold" TextColor="#123A5A" />
                                        <Label Text="{Binding Balance, StringFormat='Saldo: $ {0:N2}'}" FontSize="22" TextColor="#123A5A" />
                                        <Label Text="{Binding Status, StringFormat='Estado: {0}'}" FontSize="12" TextColor="#087D55" />
                                        <Label Text="{Binding Branch}" TextColor="#597083" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="SummaryStatus" TextColor="#087D55" />
                </VerticalStackLayout>

                <!-- Movimientos -->
                <VerticalStackLayout x:Name="MovementsSection" IsVisible="False" Spacing="12">
                    <Label Text="Movimientos" FontSize="25" FontAttributes="Bold" TextColor="#123A5A" />
                    <Label Text="Consulta el historial de una cuenta." TextColor="#597083" />
                    <Entry x:Name="MovementAccount" Placeholder="Número de cuenta" Keyboard="Numeric" />
                    <Button x:Name="MovementButton" Text="Consultar historial" Clicked="QueryMovements" BackgroundColor="#23689B" TextColor="White" />
                    <Label x:Name="MovementStatus" TextColor="#087D55" />
                    <CollectionView x:Name="Movements" HeightRequest="360">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="12" Margin="0,4" Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Label Text="{Binding DisplayType}" FontAttributes="Bold" TextColor="#123A5A" />
                                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='$ {0:N2}'}" FontAttributes="Bold" TextColor="#123A5A" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="#597083" />
                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" TextColor="#597083" LineBreakMode="TailTruncation" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Transferencia -->
                <Frame x:Name="TransferSection" IsVisible="False" BackgroundColor="White" CornerRadius="16" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Transferir dinero" FontSize="24" FontAttributes="Bold" TextColor="#123A5A" />
                        <Label Text="Envía dinero entre cuentas activas." TextColor="#597083" />
                        <Entry x:Name="Origin" Placeholder="Cuenta origen" Keyboard="Numeric" />
                        <Entry x:Name="Destination" Placeholder="Cuenta destino" Keyboard="Numeric" />
                        <Entry x:Name="Amount" Placeholder="Monto (ej. 7,20)" Keyboard="Numeric" />
                        <Label x:Name="TransferStatus" TextColor="#087D55" />
                        <Button x:Name="TransferButton" Text="Confirmar transferencia" Clicked="Transfer" BackgroundColor="#23689B" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Operaciones de caja -->
                <VerticalStackLayout x:Name="OperationsSection" IsVisible="False" Spacing="14">
                    <Frame BackgroundColor="White" CornerRadius="16" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Depósito o retiro" FontSize="24" FontAttributes="Bold" TextColor="#123A5A" />
                            <Picker x:Name="CashType" SelectedIndex="0">
                                <Picker.Items><x:String>Depósito</x:String><x:String>Retiro</x:String></Picker.Items>
                            </Picker>
                            <Entry x:Name="CashAccount" Placeholder="Número de cuenta" Keyboard="Numeric" />
                            <Entry x:Name="CashAmount" Placeholder="Monto (ej. 7,20)" Keyboard="Numeric" />
                            <Label x:Name="CashStatus" TextColor="#087D55" />
                            <Button x:Name="CashButton" Text="Registrar operación" Clicked="RegisterCashOperation" BackgroundColor="#23689B" TextColor="White" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame BackgroundColor="White" CornerRadius="16" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Reversar movimiento" FontSize="22" FontAttributes="Bold" TextColor="#123A5A" />
                            <Label Text="La reversa conserva el registro original." TextColor="#597083" />
                            <Entry x:Name="ReverseId" Placeholder="ID de transacción" />
                            <Label x:Name="ReverseStatus" TextColor="#087D55" />
                            <Button x:Name="ReverseButton" Text="Reversar movimiento" Clicked="ReverseMovement" BackgroundColor="#FFF2F3" TextColor="#BD4253" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Administración -->
                <Frame x:Name="AccountsSection" IsVisible="False" BackgroundColor="White" CornerRadius="16" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Crear cuenta" FontSize="24" FontAttributes="Bold" TextColor="#123A5A" />
                        <Label Text="Selecciona el cliente titular." TextColor="#597083" />
                        <Picker x:Name="CustomerPicker" Title="Cliente titular" ItemDisplayBinding="{Binding Name}" />
                        <Label x:Name="AccountsStatus" TextColor="#087D55" />
                        <Button x:Name="CreateAccountButton" Text="Crear y asignar cuenta" Clicked="CreateAccount" BackgroundColor="#23689B" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Perfil -->
                <Frame x:Name="ProfileSection" IsVisible="False" BackgroundColor="White" CornerRadius="16" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mi perfil" FontSize="24" FontAttributes="Bold" TextColor="#123A5A" />
                        <Label x:Name="ProfileName" FontSize="20" FontAttributes="Bold" TextColor="#123A5A" />
                        <Label x:Name="ProfileUser" TextColor="#597083" />
                        <Label x:Name="ProfilePhone" TextColor="#597083" />
                        <Label x:Name="ProfileAccounts" TextColor="#597083" />
                        <Label x:Name="ProfileStatus" TextColor="#087D55" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
