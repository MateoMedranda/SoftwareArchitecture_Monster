# Plantilla de configuración local. Copie este archivo como .development.env
# (ignorado por git) y complete los valores de su instancia de SQL Server.
DB_HOST=<endpoint-de-la-instancia-rds>
DB_PORT=1433
DB_NAME=arquitectura_db
DB_USER=<usuario>
DB_PASSWORD=<contraseña>

# Pool pequeño para la instancia SQL Server de AWS (free tier).
DB_MIN_POOL=1
DB_MAX_POOL=6
DB_CONNECT_TIMEOUT=30
DB_CONNECTION_LIFETIME=300
