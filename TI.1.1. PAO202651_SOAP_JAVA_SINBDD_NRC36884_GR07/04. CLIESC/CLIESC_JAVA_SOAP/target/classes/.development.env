# .env
# --- Servidor SOAP (Payara en Docker) ---
SOAP_HOST=localhost
SOAP_PORT=8181
SOAP_PROTOCOL=https
SOAP_CONTEXT=/WS_CON_UNI_JAVA_SOAP
SOAP_SERVICE=WSConversorUnidades

# URL completa del endpoint cambiar segun puertos e ip
SOAP_ENDPOINT=https://localhost:8181/WS_CON_UNI_JAVA_SOAP/WSConversorUnidades

# URL del WSDL
SOAP_WSDL=https://localhost:8181/WS_CON_UNI_JAVA_SOAP/WSConversorUnidades?wsdl

# Namespace del servicio (targetNamespace del WSDL)
SOAP_TARGET_NAMESPACE=http://ws.monster.edu.ec/

# Credenciales para login/cambiarContrasenia
SOAP_USER=MONSTER
SOAP_PASSWORD=MONSTER9

# Timeouts (ms)
SOAP_CONNECT_TIMEOUT=10000
SOAP_READ_TIMEOUT=30000

# Seguridad TLS (porque usas https con cert autofirmado en local)
SOAP_INSECURE_TLS=true