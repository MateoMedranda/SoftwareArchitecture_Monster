<ContentPage x:Class="EurekaBank.Mobile.MainPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="#F1F7FB" Title="EUREKABANK"><ScrollView><VerticalStackLayout Padding="28" Spacing="12"><Frame x:Name="LoginCard" BackgroundColor="White" CornerRadius="24" Padding="26"><VerticalStackLayout Spacing="12"><Label Text="◆ EUREKABANK" FontSize="26" FontAttributes="Bold" TextColor="#123A5A" HorizontalOptions="Center"/><Label Text="Tu banca, siempre contigo" HorizontalOptions="Center" TextColor="#597083"/><Entry x:Name="UserName" Placeholder="Usuario"/><Entry x:Name="Password" Placeholder="Contraseña" IsPassword="True"/><Label x:Name="LoginStatus" TextColor="#BD4253"/><Button Text="Ingresar a mi banca" Clicked="SignIn" BackgroundColor="#23689B" TextColor="White"/></VerticalStackLayout></Frame><VerticalStackLayout x:Name="Dashboard" IsVisible="False" Spacing="14"><HorizontalStackLayout><Label x:Name="Welcome" FontSize="24" FontAttributes="Bold" TextColor="#123A5A" HorizontalOptions="FillAndExpand"/><Button Text="Salir" Clicked="SignOut"/></HorizontalStackLayout><Label Text="Tu resumen financiero" FontSize="18"/><CollectionView x:Name="Accounts"><CollectionView.ItemTemplate><DataTemplate><Frame BackgroundColor="White" CornerRadius="14" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Number, StringFormat='Cuenta {0}'}" FontAttributes="Bold"/><Label Text="{Binding Balance, StringFormat='Saldo: $ {0:N2}'}" FontSize="22" TextColor="#123A5A"/><Label Text="{Binding Branch}" TextColor="#597083"/></VerticalStackLayout></Frame></DataTemplate></CollectionView.ItemTemplate></CollectionView><Frame BackgroundColor="White"><VerticalStackLayout><Label Text="Transferir dinero" FontSize="20" FontAttributes="Bold"/><Entry x:Name="Origin" Placeholder="Cuenta origen" Keyboard="Numeric"/><Entry x:Name="Destination" Placeholder="Cuenta destino" Keyboard="Numeric"/><Entry x:Name="Amount" Placeholder="Monto" Keyboard="Numeric"/><Button Text="Confirmar transferencia" Clicked="Transfer" BackgroundColor="#23689B" TextColor="White"/></VerticalStackLayout></Frame><Label x:Name="Status" TextColor="#087D55"/></VerticalStackLayout></VerticalStackLayout></ScrollView></ContentPage>
