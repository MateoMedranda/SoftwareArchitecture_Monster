# ==== EurekaBank - configuracion local ====
# Copiar este archivo a .development.env y completar los valores reales.
# .development.env NO se versiona (ver .gitignore).

# --- SQL Server en AWS RDS ---
# Endpoint del RDS (sin protocolo y sin puerto; el puerto va en DB_PORT)
DB_HOST=eurekabank-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=1433
DB_NAME=arquitectura_db
# RDS no permite 'sa': usar el usuario maestro o uno con permisos
DB_USER=admin_eurekabank
DB_PASSWORD=CAMBIA_ESTA_CONTRASENIA

# --- Opcional: cadena completa (tiene prioridad sobre las variables DB_*) ---
# ConnectionStrings__EurekaBank=Server=host,1433;Database=arquitectura_db;User Id=usuario;Password=clave;Encrypt=True;TrustServerCertificate=True

# --- Seguridad ---
SECURITY_JWT_KEY=CAMBIA-ESTA-CLAVE-EN-PRODUCCION-EUREKABANK-2026
