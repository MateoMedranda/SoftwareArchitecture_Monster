<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonsterConversorMovil.Views.ConverterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7FB">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="22,22,22,20" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="1">
                <Label Text="MONSTER" FontSize="22" TextColor="#17365D" FontFamily="OpenSansSemibold" />
                <Label x:Name="GreetingLabel" Text="Conversor de temperatura" FontSize="13" TextColor="#65758B" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Salir" Clicked="OnSignOutClicked" BackgroundColor="Transparent" TextColor="#17365D" BorderColor="#B9C8D8" BorderWidth="1" CornerRadius="12" Padding="14,6" FontSize="12" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,28" Spacing="18">
                <Border BackgroundColor="#17365D" StrokeThickness="0" Padding="22" StrokeShape="RoundRectangle 22">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Conversión en línea" TextColor="#DCEAF7" FontSize="13" />
                            <Label Text="Temperatura" TextColor="White" FontSize="27" FontFamily="OpenSansSemibold" />
                            <Label Text="Conectado al servicio SOAP" TextColor="#A9C8DD" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#F4B41A" StrokeThickness="0" StrokeShape="RoundRectangle 16" HeightRequest="56" WidthRequest="56">
                            <Label Text="°" FontSize="38" TextColor="#17365D" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 20">
                    <Border.Shadow>
                        <Shadow Brush="#1A17365D" Offset="0,5" Radius="14" Opacity="0.22" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Valor a convertir" TextColor="#17365D" FontFamily="OpenSansSemibold" FontSize="14" />
                        <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="13,2">
                            <Entry x:Name="ValueEntry" Placeholder="Ej. 25" Keyboard="Numeric" FontSize="24" TextColor="#14213D" PlaceholderColor="#93A4B8" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="DE" FontSize="11" TextColor="#65758B" FontFamily="OpenSansSemibold" />
                                <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="8,0">
                                    <Picker x:Name="OriginPicker" Title="Unidad" ItemDisplayBinding="{Binding Name}" TextColor="#14213D" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="7">
                                <Label Text="A" FontSize="11" TextColor="#65758B" FontFamily="OpenSansSemibold" />
                                <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="8,0">
                                    <Picker x:Name="DestinationPicker" Title="Unidad" ItemDisplayBinding="{Binding Name}" TextColor="#14213D" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button x:Name="ConvertButton" Text="CONVERTIR" Clicked="OnConvertClicked" BackgroundColor="#F4B41A" TextColor="#14213D" FontFamily="OpenSansSemibold" CornerRadius="13" HeightRequest="52" Margin="0,7,0,0" />
                        <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#17365D" HeightRequest="8" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ResultCard" IsVisible="False" BackgroundColor="#EAF7F2" Stroke="#B7E3D0" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="RESULTADO" FontSize="11" TextColor="#16835D" FontFamily="OpenSansSemibold" />
                        <Label x:Name="ResultLabel" TextColor="#14213D" FontSize="32" FontFamily="OpenSansSemibold" />
                        <Label x:Name="ResultDetailLabel" TextColor="#3B6B59" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel" IsVisible="False" FontSize="13" LineBreakMode="WordWrap" />
                <Label Text="Rango físico del agua a 1 atm: el servicio valida cada entrada antes de convertirla." FontSize="12" TextColor="#65758B" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" Margin="16,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
