<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonsterConversorMovil.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7FB">
    <Grid RowDefinitions="0.39*,0.61*">
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0C2340" Offset="0" />
                    <GradientStop Color="#1E4B7A" Offset="0.62" />
                    <GradientStop Color="#276F8E" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Padding="30,42,30,20" Spacing="10" VerticalOptions="Center">
                <Image Source="logo_monster.svg" HeightRequest="72" Aspect="AspectFit" HorizontalOptions="Start" />
                <Label Text="Conversor de unidades" TextColor="White" FontSize="28" FontFamily="OpenSansSemibold" />
                <Label Text="Precisión para cada medida." TextColor="#DCEAF7" FontSize="15" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Margin="20,-22,20,20">
            <Border BackgroundColor="White" StrokeThickness="0" Padding="24" StrokeShape="RoundRectangle 22">
                <Border.Shadow>
                    <Shadow Brush="#2A17365D" Offset="0,7" Radius="18" Opacity="0.24" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Bienvenido" FontSize="25" TextColor="#14213D" FontFamily="OpenSansSemibold" />
                    <Label Text="Ingresa con tus credenciales para consultar el servicio SOAP." FontSize="13" TextColor="#65758B" LineBreakMode="WordWrap" />

                    <Label Text="Usuario" FontSize="13" TextColor="#17365D" FontFamily="OpenSansSemibold" Margin="0,8,0,-8" />
                    <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="12,2">
                        <Entry x:Name="UserNameEntry" Placeholder="Ej. MONSTER" Text="MONSTER" TextColor="#14213D" PlaceholderColor="#93A4B8" ClearButtonVisibility="WhileEditing" />
                    </Border>

                    <Label Text="Contraseña" FontSize="13" TextColor="#17365D" FontFamily="OpenSansSemibold" Margin="0,2,0,-8" />
                    <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="12,2">
                        <Entry x:Name="PasswordEntry" Placeholder="Contraseña" Text="MONSTER9" IsPassword="True" TextColor="#14213D" PlaceholderColor="#93A4B8" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,-8">
                        <Label Text="Servicio SOAP" FontSize="13" TextColor="#17365D" FontFamily="OpenSansSemibold" />
                        <Label Grid.Column="1" Text="Editar dirección" FontSize="12" TextColor="#16835D" />
                    </Grid>
                    <Border BackgroundColor="#F4F7FB" Stroke="#E0E8F1" StrokeShape="RoundRectangle 12" Padding="12,2">
                        <Entry x:Name="EndpointEntry" Keyboard="Url" FontSize="12" TextColor="#14213D" PlaceholderColor="#93A4B8" />
                    </Border>

                    <Label x:Name="StatusLabel" IsVisible="False" FontSize="13" LineBreakMode="WordWrap" />
                    <Button x:Name="SignInButton" Text="INGRESAR" Clicked="OnSignInClicked" BackgroundColor="#F4B41A" TextColor="#14213D" FontFamily="OpenSansSemibold" CornerRadius="13" HeightRequest="52" Margin="0,4,0,0" />
                    <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#17365D" HeightRequest="12" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
