<UserControl x:Class="ClienteEscritorioConversion.Vistas.VistaConversion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:ClienteEscritorioConversion.Componentes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Recursos/Estilos.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PincelFondo}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Conversión de Unidades" Style="{StaticResource TituloVista}" />
                    <TextBlock x:Name="TextoUsuario"
                               Style="{StaticResource SubtituloVista}"
                               Margin="0,0,0,0" />
                </StackPanel>

                <Button x:Name="BotonCerrarSesion"
                        Content="Cerrar Sesión"
                        Style="{StaticResource BotonSecundario}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="BotonCerrarSesion_Click" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource PincelTarjeta}"
                    BorderBrush="{StaticResource PincelBorde}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,20,0,0"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Tipo de conversión" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox x:Name="ComboCategoria"
                                  Style="{StaticResource CampoSeleccion}"
                                  SelectionChanged="ComboCategoria_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Unidad origen" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox x:Name="ComboOrigen"
                                  Style="{StaticResource CampoSeleccion}"
                                  SelectionChanged="ComboUnidad_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unidad destino" Style="{StaticResource EtiquetaCampo}" />
                        <ComboBox x:Name="ComboDestino"
                                  Style="{StaticResource CampoSeleccion}"
                                  SelectionChanged="ComboUnidad_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
                        <TextBlock Text="Valor a convertir" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox x:Name="CampoValor"
                                 Style="{StaticResource CampoTexto}"
                                 TextChanged="CampoValor_TextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,24,0,0">
                        <Button x:Name="BotonConvertir"
                                Content="Convertir"
                                Style="{StaticResource BotonPrincipal}"
                                HorizontalAlignment="Left"
                                MinWidth="160"
                                Click="BotonConvertir_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Border x:Name="MarcoResultado"
                        Background="{StaticResource PincelExitoFondo}"
                        BorderBrush="{StaticResource PincelExitoTexto}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TextoResultado"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PincelExitoTexto}" />
                </Border>

                <componentes:ControlMensaje x:Name="Banner" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
