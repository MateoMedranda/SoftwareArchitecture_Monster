<UserControl x:Class="ClienteEscritorioConversion.Vistas.VistaInicioSesion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:ClienteEscritorioConversion.Componentes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Recursos/Estilos.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PincelFondo}">
        <Border Background="{StaticResource PincelTarjeta}"
                BorderBrush="{StaticResource PincelBorde}"
                BorderThickness="1"
                CornerRadius="8"
                Width="440"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Logo: se muestra si Recursos/logo.png existe (colócalo luego). -->
                <Image x:Name="ImagenLogo"
                       Source="/Recursos/logo.png"
                       Width="120"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       ImageFailed="ImagenLogo_ImageFailed" />

                <TextBlock Text="Conversión de Unidades"
                           Style="{StaticResource TituloVista}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" />
                <TextBlock Text="Cliente de escritorio · MONSTER"
                           Style="{StaticResource SubtituloVista}"
                           HorizontalAlignment="Center" />

                <Separator Margin="0,0,0,20" />

                <TextBlock Text="Usuario" Style="{StaticResource EtiquetaCampo}" />
                <TextBox x:Name="CampoUsuario"
                         Style="{StaticResource CampoTexto}"
                         TextChanged="CampoUsuario_TextChanged" />

                <TextBlock Text="Contraseña"
                           Style="{StaticResource EtiquetaCampo}"
                           Margin="0,16,0,6" />
                <PasswordBox x:Name="CampoContrasena"
                             Style="{StaticResource CampoContrasena}"
                             PasswordChanged="CampoContrasena_PasswordChanged" />

                <Button x:Name="BotonIngresar"
                        Content="Iniciar Sesión"
                        Style="{StaticResource BotonPrincipal}"
                        Margin="0,24,0,0"
                        IsDefault="True"
                        Click="BotonIngresar_Click" />

                <componentes:ControlMensaje x:Name="Banner"
                                            Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
