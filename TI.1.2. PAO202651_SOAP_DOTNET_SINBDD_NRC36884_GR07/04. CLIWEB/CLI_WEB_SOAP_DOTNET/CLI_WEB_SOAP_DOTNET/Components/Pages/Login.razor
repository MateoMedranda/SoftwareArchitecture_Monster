@page "/login"
@rendermode InteractiveServer
@inject LoginController Controlador

<PageTitle>Iniciar sesión</PageTitle>

@* VISTA de MVC: solo presenta datos y delega toda la lógica en LoginController *@
<div class="contenido contenido-login">
    <div class="tarjeta tarjeta-login">
        <img class="logo" src="images/logo.png" alt="Logo Conversor unidades" />
        <h1>Conversor unidades MONSTER</h1>

        <EditForm Model="credenciales" OnValidSubmit="EnviarAsync" FormName="login">
            <DataAnnotationsValidator />

            <div class="campo campo-login">
                <label for="usuario">Usuario</label>
                <InputText id="usuario" @bind-Value="credenciales.NombreUsuario" autocomplete="username" type="text" />
                <ValidationMessage For="() => credenciales.NombreUsuario" />
            </div>

            <div class="campo campo-login">
                <label for="clave">Contraseña</label>
                <InputText id="clave" type="password" placeholder="Ingrese su contrasena"
                           @bind-Value="credenciales.Contrasena" autocomplete="current-password" />
                <ValidationMessage For="() => credenciales.Contrasena" />
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="error" role="alert">@mensajeError</div>
            }

            <button type="submit" class="boton boton-login" disabled="@cargando">
                @(cargando ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private readonly CredencialesLogin credenciales = new();
    private string? mensajeError;
    private bool cargando;

    private async Task EnviarAsync()
    {
        cargando = true;
        mensajeError = null;

        var resultado = await Controlador.IniciarSesionAsync(credenciales);

        if (!resultado.Exito)
            mensajeError = resultado.Mensaje;

        cargando = false;
    }
}


