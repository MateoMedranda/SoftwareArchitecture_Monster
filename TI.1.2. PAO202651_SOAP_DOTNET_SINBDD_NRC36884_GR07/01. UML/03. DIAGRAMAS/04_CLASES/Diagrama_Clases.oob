</o:Operation>
<o:Operation Id="o198">
<a:ObjectID>57B76B9A-0925-4142-BCEA-FA36E27184D7</a:ObjectID>
<a:Name>EsNumeroSintactico</a:Name>
<a:Code>EsNumeroSintactico</a:Code>
<a:CreationDate>1792608653</a:CreationDate>
<a:Creator>gmlop</a:Creator>
<a:ModificationDate>1792608667</a:ModificationDate>
<a:Modifier>gmlop</a:Modifier>
<a:Comment>&lt;summary&gt;
Indica si el texto recibido tiene forma de número (signo, dígitos, punto y exponente),
sin importar que su magnitud no quepa en un double.
&lt;/summary&gt;</a:Comment>
<a:ReturnType>bool</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    if (string.IsNullOrWhiteSpace(valor))
    {
        return false;
    }

    string texto = valor.Trim();
    bool digito = false;
    bool punto = false;
    bool exponente = false;

    for (int i = 0; i &lt; texto.Length; i++)
    {
        char caracter = texto[i];

        if (caracter &gt;= &#39;0&#39; &amp;&amp; caracter &lt;= &#39;9&#39;)
        {
            digito = true;
            continue;
        }

        if ((caracter == &#39;+&#39; || caracter == &#39;-&#39;) &amp;&amp; i == 0)
        {
            continue;
        }

        if (caracter == &#39;.&#39; &amp;&amp; !punto &amp;&amp; !exponente)
        {
            punto = true;
            continue;
        }

        if ((caracter == &#39;e&#39; || caracter == &#39;E&#39;) &amp;&amp; digito &amp;&amp; !exponente)
        {
            exponente = true;
            // El exponente puede empezar con signo.
            if (i + 1 &lt; texto.Length &amp;&amp; (texto[i + 1] == &#39;+&#39; || texto[i + 1] == &#39;-&#39;))
            {
                i++;
            }

            continue;
        }

        return false;
    }

    return digito;
}</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o199">
<a:ObjectID>ABC2D680-FC08-4D85-9E8B-AAA9B97EF809</a:ObjectID>
<a:Name>valor</a:Name>
