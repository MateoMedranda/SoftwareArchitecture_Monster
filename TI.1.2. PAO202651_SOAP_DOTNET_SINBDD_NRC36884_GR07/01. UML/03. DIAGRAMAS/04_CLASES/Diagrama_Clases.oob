<o:Operation Id="o192">
<a:ObjectID>8A91992E-69AA-41A8-B606-1828A1A56956</a:ObjectID>
<a:Name>IniciarSesion</a:Name>
<a:Code>IniciarSesion</a:Code>
<a:CreationDate>1792608653</a:CreationDate>
<a:Creator>gmlop</a:Creator>
<a:ModificationDate>1792608667</a:ModificationDate>
<a:Modifier>gmlop</a:Modifier>
<a:Stereotype>Implement</a:Stereotype>
<a:ReturnType>RespuestaInicioSesion</a:ReturnType>
<a:TemplateBody>{
    if (solicitud == null)
    {
        return new RespuestaInicioSesion
        {
            Exito = false,
            Token = null,
            Mensaje = MensajesError.SolicitudInicioSesionObligatoria
        };
    }

    string usuario = ConfigurationManager.AppSettings[&quot;UsuarioDemo&quot;] ?? UsuarioPorDefecto;
    string contrasena = ConfigurationManager.AppSettings[&quot;ContrasenaDemo&quot;] ?? ContrasenaPorDefecto;

    bool credencialesValidas =
        string.Equals(solicitud.NombreUsuario, usuario, StringComparison.Ordinal) &amp;&amp;
        string.Equals(solicitud.Contrasena, contrasena, StringComparison.Ordinal);

    if (!credencialesValidas)
    {
        return new RespuestaInicioSesion
        {
            Exito = false,
            Token = null,
            Mensaje = MensajesError.CredencialesInvalidas
        };
    }

    string token = almacenTokens.GenerarToken(solicitud.NombreUsuario);
    return new RespuestaInicioSesion
    {
        Exito = true,
        Token = token,
        Mensaje = MensajesError.InicioSesionExitoso
    };
}</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o193">
<a:ObjectID>A57AE7FD-C567-48AD-806B-98A0BBF38056</a:ObjectID>
<a:Name>solicitud</a:Name>
<a:Code>solicitud</a:Code>
<a:CreationDate>1792608653</a:CreationDate>
<a:Creator>gmlop</a:Creator>
<a:ModificationDate>1792608667</a:ModificationDate>
<a:Modifier>gmlop</a:Modifier>
<a:Parameter.DataType>SolicitudInicioSesion</a:Parameter.DataType>
<a:ParameterType>I</a:ParameterType>
</o:Parameter>
</c:Parameters>
