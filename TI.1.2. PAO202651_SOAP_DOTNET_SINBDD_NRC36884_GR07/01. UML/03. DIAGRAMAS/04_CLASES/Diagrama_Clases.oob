<a:Creator>gmlop</a:Creator>
<a:ModificationDate>1792608667</a:ModificationDate>
<a:Modifier>gmlop</a:Modifier>
<a:ReturnType>RespuestaConversionMensaje</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    return new RespuestaConversionMensaje
    {
        Resultado = new RespuestaConversion
        {
            Exito = false,
            ValorConvertido = 0.0,
            Mensaje = mensaje
        }
    };
}</a:TemplateBody>
