@inherits LayoutComponentBase

<div class="aplicacion-movil">
    <header class="barra-movil">
        <a class="marca-movil" href="/">
            <img src="img/logo.png" alt="Celulares Monster" />
            <span>
                <strong>Celulares Monster</strong>
                <small>Facturación móvil</small>
            </span>
        </a>
        <div class="herramientas-servidor">
            <span class="conexion-api" title="@AppConfig.ApiBaseUrl">API</span>
            <button type="button" class="boton-servidor" title="Cambiar dirección del servidor" @onclick="AbrirServidor">Servidor</button>
        </div>
    </header>

    <main class="contenido-movil">
        @Body
    </main>

    <nav class="navegacion-inferior" aria-label="Navegación principal">
        <NavLink href="/" Match="NavLinkMatch.All">
            <span class="nav-icono" aria-hidden="true">&#8962;</span>
            <span>Inicio</span>
        </NavLink>
        <NavLink href="/facturas">
            <span class="nav-icono" aria-hidden="true">&#128196;</span>
            <span>Facturas</span>
        </NavLink>
        <NavLink href="/creditos">
            <span class="nav-icono" aria-hidden="true">&#128179;</span>
            <span>Créditos</span>
        </NavLink>
        <NavLink href="/compra" class="nav-central">
            <span class="nav-icono" aria-hidden="true">+</span>
            <span>Compra</span>
        </NavLink>
        <NavLink href="/clientes">
            <span class="nav-icono" aria-hidden="true">&#128100;</span>
            <span>Clientes</span>
        </NavLink>
        <NavLink href="/catalogo">
            <span class="nav-icono" aria-hidden="true">&#128241;</span>
            <span>Catálogo</span>
        </NavLink>
    </nav>
</div>

@if (mostrarServidor)
{
    <div class="modal-fondo" role="presentation">
        <section class="modal modal-servidor" role="dialog" aria-modal="true" aria-labelledby="titulo-servidor">
            <header class="modal-cabecera">
                <h2 id="titulo-servidor">Servidor</h2>
                <button type="button" class="boton-cerrar" aria-label="Cerrar" @onclick="CerrarServidor">×</button>
            </header>
            <div class="modal-cuerpo">
                <p class="nota">Escriba la URL del API de Facturación. El cambio se guarda en este dispositivo.</p>
                <div class="grupo-campo">
                    <label for="url-servidor">URL del servidor</label>
                    <input id="url-servidor" class="campo" type="url" inputmode="url" autocomplete="url"
                           placeholder="http://192.168.1.20:5226/" @bind="urlServidor" />
                    <small>En emulador Android use: http://10.0.2.2:5226/</small>
                </div>
                @if (!string.IsNullOrWhiteSpace(errorServidor))
                {
                    <div class="alerta alerta-error">@errorServidor</div>
                }
                @if (!string.IsNullOrWhiteSpace(exitoServidor))
                {
                    <div class="alerta alerta-exito">@exitoServidor</div>
                }
                <div class="modal-acciones">
                    <button type="button" class="boton boton-morado" @onclick="GuardarServidor">Guardar</button>
                    <button type="button" class="boton boton-secundario" @onclick="CerrarServidor">Cancelar</button>
                </div>
            </div>
        </section>
    </div>
}

@code {
    private bool mostrarServidor;
    private string urlServidor = string.Empty;
    private string? errorServidor;
    private string? exitoServidor;

    private void AbrirServidor()
    {
        urlServidor = AppConfig.ApiBaseUrl;
        errorServidor = null;
        exitoServidor = null;
        mostrarServidor = true;
    }

    private void CerrarServidor() => mostrarServidor = false;

    private void GuardarServidor()
    {
        if (!AppConfig.IntentarActualizarUrl(urlServidor, out var error))
        {
            errorServidor = error;
            exitoServidor = null;
            return;
        }

        urlServidor = AppConfig.ApiBaseUrl;
        errorServidor = null;
        exitoServidor = "Servidor actualizado. Las próximas consultas usarán esta dirección.";
    }
}
