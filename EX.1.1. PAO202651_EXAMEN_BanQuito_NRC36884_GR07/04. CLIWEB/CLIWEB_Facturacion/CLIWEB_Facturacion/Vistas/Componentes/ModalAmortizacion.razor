<Modal Visible="Visible" Titulo="Tabla de amortización" Clase="modal-ancho" OnCerrar="OnCerrar">
    @if (Cargando)
    {
        <div class="cargando">
            <span class="cargador"></span>
            <span>Consultando la tabla de amortización...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alerta alerta-error">@Error</div>
    }
    else if (Amortizacion is null)
    {
        <div class="estado-vacio estado-vacio-compacto">
            <p>No hay una tabla de amortización disponible.</p>
        </div>
    }
    else
    {
        <TablaAmortizacion Amortizacion="Amortizacion" />
    }

    <div class="modal-acciones">
        <button type="button" class="boton boton-secundario" @onclick="OnCerrar">Cerrar</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public bool Cargando { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public AmortizacionDTO? Amortizacion { get; set; }

    [Parameter] public EventCallback OnCerrar { get; set; }
}
