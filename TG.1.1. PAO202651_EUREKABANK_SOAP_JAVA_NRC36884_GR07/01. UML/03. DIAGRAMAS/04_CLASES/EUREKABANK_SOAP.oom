<o:Operation Id="o1385">
<a:ObjectID>0CE09679-7F87-4B8B-A112-1183139E3BAB</a:ObjectID>
<a:Name>crearMovimiento</a:Name>
<a:Code>crearMovimiento</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>TransaccionDTO</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>        {
    TransaccionDTO movimiento = new TransaccionDTO();
    movimiento.setTransaccionId(UUID.randomUUID().toString());
    movimiento.setCuentaId(cuentaId);
    movimiento.setTransaccionSaldo(monto);
    movimiento.setTransaccionTipo(tipo);
    movimiento.setTransaccionSaldoAnterior(saldoAnterior);
    movimiento.setTransaccionSaldoPosterior(saldoPosterior);
    movimiento.setTransaccionCreadoEn(fecha);
    movimiento.setTransaccionCreadoPor(creadoPor);
    return movimiento;
}
