<o:Operation Id="o1274">
<a:ObjectID>4213540C-EA2F-48F3-A0F8-240BACB24462</a:ObjectID>
<a:Name>logout</a:Name>
<a:Code>logout</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  Operación 2: logout (protegida — requiere token válido)
 ─────────────────────────────────────────────────────────────────────────
Cierra la sesión del usuario revocando el token JWT.
El token queda registrado como INACTIVO en la tabla TOKEN.
</a:Comment>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Throws>LoginExcepcion</a:Operation.Throws>
<a:TemplateBody>{

    // Verificar que el token sea válido antes de revocar
    verificarTokenOLanzar(token, &quot;logout&quot;);

    boolean revocado = tokenGenerador.revocarToken(token);
    if (!revocado) {
        throw new LoginExcepcion(
            &quot;No se pudo cerrar la sesión&quot;,
            new RespuestaError(
                &quot;LOGOUT_FALLIDO&quot;,
                &quot;No se pudo cerrar la sesión. Es posible que el token ya haya sido revocado.&quot;,
                null
            )
        );
    }

    LOG.info(&quot;[LoginServicio] Logout exitoso.&quot;);
    return true;
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,231={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,37=@return true si el logout fue exitoso
{F03653A9-9917-45E2-8F4E-2713C1F58F40},Javadoc@throws,76=@throws LoginExcepcion si el token es inválido, expirado o ya fue revocado


</a:ExtendedAttributesText>
<c:Parameters>
