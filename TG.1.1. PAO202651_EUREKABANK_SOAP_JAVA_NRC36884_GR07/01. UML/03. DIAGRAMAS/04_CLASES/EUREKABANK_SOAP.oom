<a:TemplateBody>{
    try { return TokenFiltro.verificar(token, tokenGenerador); }
    catch (ec.edu.monster.modelos.Respuestas.LoginExcepcion e) {
        throw new TransaccionExcepcion(e.getMessage(), e.getFaultInfo());
    }
}
</a:TemplateBody>
