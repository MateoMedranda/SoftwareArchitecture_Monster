<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    return &quot;23000&quot;.equals(e.getSQLState()) &amp;&amp; e.getMessage() != null
            &amp;&amp; e.getMessage().contains(&quot;UK_CUENTA_NUMERO&quot;);
}
