<o:Operation Id="o1393">
<a:ObjectID>163B625E-1A14-4F65-B0AA-CE89F6DB1910</a:ObjectID>
<a:Name>ejecutarEnTransaccion</a:Name>
<a:Code>ejecutarEnTransaccion</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>T</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    try (Connection conexion = conexionBDD.getConexion()) {
        conexion.setAutoCommit(false);
        try {
            T resultado = trabajo.ejecutar(conexion);
            conexion.commit();
            return resultado;
        } catch (TransaccionExcepcion | SQLException e) {
            rollbackSilencioso(conexion);
            if (e instanceof TransaccionExcepcion) throw (TransaccionExcepcion) e;
            throw errorBaseDatos(&quot;No se pudo procesar la transacción.&quot;, (SQLException) e);
        } catch (RuntimeException e) {
            rollbackSilencioso(conexion);
            throw e;
        }
    } catch (SQLException e) {
        throw errorBaseDatos(&quot;No se pudo iniciar la transacción.&quot;, e);
    }
}
</a:TemplateBody>
<c:Parameters>
