<o:Operation Id="o479">
<a:ObjectID>FA520FAF-C377-47E6-B8C7-9DC70D1DCAAC</a:ObjectID>
<a:Name>obtenerNombreSucursal</a:Name>
<a:Code>obtenerNombreSucursal</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    try (PreparedStatement ps = con.prepareStatement(
            &quot;SELECT SUCURSAL_NOMBRE FROM SUCURSAL WHERE SUCURSAL_ID=?&quot;)) {
        ps.setString(1, sucursalId);
        try (ResultSet rs = ps.executeQuery()) {
            return rs.next() ? rs.getString(&quot;SUCURSAL_NOMBRE&quot;) : null;
        }
    }
}
</a:TemplateBody>
<c:Parameters>
