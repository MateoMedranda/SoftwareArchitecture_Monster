<a:Name>eliminarTransaccion</a:Name>
<a:Code>eliminarTransaccion</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>El historial financiero es inmutable; para corregirlo se debe registrar una reversa autorizada.</a:Comment>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    validarToken(token);
    throw error(&quot;TRANSACCION_INMUTABLE&quot;,
            &quot;Los movimientos contables no se eliminan. Registre una operación de reversa autorizada.&quot;,
            &quot;transaccionId&quot;);
}
</a:TemplateBody>
<c:Parameters>
