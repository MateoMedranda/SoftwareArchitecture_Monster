<a:ObjectID>80F5AA03-C267-481D-B564-9E464C8206D8</a:ObjectID>
<a:Name>insertar</a:Name>
<a:Code>insertar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;INSERT INTO TRANSACCION (TRANSACCION_ID,CUENTA_ID,TRANSACCION_SALDO,TRANSACCION_TIPO,TRANSACCION_SALDO_ANTERIOR,TRANSACCION_SALDO_POSTERIOR,TRANSACCION_CREADO_EN,TRANSACCION_CREADO_POR) VALUES (?,?,?,?,?,?,?,?)&quot;;
    try (Connection con = conexionBDD.getConexion(); PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1,t.getTransaccionId()); ps.setString(2,t.getCuentaId());
        ps.setBigDecimal(3,t.getTransaccionSaldo()); ps.setString(4,t.getTransaccionTipo());
        ps.setBigDecimal(5,t.getTransaccionSaldoAnterior()); ps.setBigDecimal(6,t.getTransaccionSaldoPosterior());
        ps.setTimestamp(7, Timestamp.valueOf(t.getTransaccionCreadoEn()));
        ps.setString(8,t.getTransaccionCreadoPor());
        ps.executeUpdate();
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o534">
<a:ObjectID>00A34F58-2E34-4FB8-8946-67090D8E51E5</a:ObjectID>
<a:Name>t</a:Name>
<a:Code>t</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>TransaccionDTO</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
