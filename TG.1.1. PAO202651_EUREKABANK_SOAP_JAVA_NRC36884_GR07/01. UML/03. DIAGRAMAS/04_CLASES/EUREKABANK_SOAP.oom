<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;SELECT 1 FROM TRANSACCION WHERE TRANSACCION_TIPO=? LIMIT 1&quot;;
    try (Connection con = conexionBDD.getConexion(); PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1, tipo);
        try (ResultSet rs = ps.executeQuery()) {
            return rs.next();
        }
    }
}
