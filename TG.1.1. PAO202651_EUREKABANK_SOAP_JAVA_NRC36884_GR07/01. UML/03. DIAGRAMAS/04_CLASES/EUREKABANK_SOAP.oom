<a:ObjectID>B13797F7-54BF-48F0-841C-553420E6B9B7</a:ObjectID>
<a:Name>calcularSaldo</a:Name>
<a:Code>calcularSaldo</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>BigDecimal</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>        {
    if (&quot;INGRESO&quot;.equals(tipo)) return saldoAnterior.add(monto);
    if (saldoAnterior.compareTo(monto) &lt; 0) {
        throw error(&quot;SALDO_INSUFICIENTE&quot;, &quot;La cuenta no tiene saldo suficiente para el retiro.&quot;, &quot;monto&quot;);
    }
    return saldoAnterior.subtract(monto);
}
</a:TemplateBody>
