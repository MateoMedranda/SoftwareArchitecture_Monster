<o:Operation Id="o1297">
<a:ObjectID>6EBF1435-12D8-4612-AB8A-82FB4F9FA057</a:ObjectID>
<a:Name>esAdminOCajero</a:Name>
<a:Code>esAdminOCajero</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    String rn = rolNombre(claims.get(&quot;rol&quot;, String.class));
    return rn.equals(&quot;ADMIN&quot;) || rn.equals(&quot;CAJERO&quot;);
}
