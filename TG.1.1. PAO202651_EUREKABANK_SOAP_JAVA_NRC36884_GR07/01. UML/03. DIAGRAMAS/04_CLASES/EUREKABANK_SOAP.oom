<o:Operation Id="o482">
<a:ObjectID>518D1910-9646-49F1-81FB-6465B0BE8D21</a:ObjectID>
<a:Name>siguienteNumeroPublico</a:Name>
<a:Code>siguienteNumeroPublico</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;SELECT COALESCE(MAX(CAST(CUENTA_NUMERO AS UNSIGNED)), 1000000000) AS ULTIMO FROM CUENTA&quot;;
    try (PreparedStatement ps = con.prepareStatement(sql); ResultSet rs = ps.executeQuery()) {
        if (!rs.next()) throw new SQLException(&quot;No se pudo calcular el siguiente número de cuenta.&quot;);
        long siguiente = Math.max(1_000_000_000L, rs.getLong(&quot;ULTIMO&quot;)) + 1;
        if (siguiente &gt; 9_999_999_999L) throw new SQLException(&quot;Se agotaron los números de cuenta disponibles.&quot;);
        return String.format(&quot;%010d&quot;, siguiente);
    }
}
</a:TemplateBody>
<c:Parameters>
