<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>CuentaDTO</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    CuentaDTO c = new CuentaDTO();
    c.setCuentaId(rs.getString(&quot;CUENTA_ID&quot;));
    c.setCuentaNumero(rs.getString(&quot;CUENTA_NUMERO&quot;));
    c.setSucursalId(rs.getString(&quot;SUCURSAL_ID&quot;));
    c.setSucursalNombre(rs.getString(&quot;SUCURSAL_NOMBRE&quot;));
    c.setCuentaSaldo(rs.getBigDecimal(&quot;CUENTA_SALDO&quot;));
    c.setCuentaEstado(rs.getString(&quot;CUENTA_ESTADO&quot;));
    return c;
}
</a:TemplateBody>
<c:Parameters>
