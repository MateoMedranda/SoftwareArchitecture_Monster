<o:Operation Id="o1206">
<a:ObjectID>8D8BDF18-9407-4E57-8F0B-C11EAEC239D9</a:ObjectID>
<a:Name>listarClientesParaCuenta</a:Name>
<a:Code>listarClientesParaCuenta</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Lista datos seguros para el selector administrativo, sin contraseñas ni hashes.</a:Comment>
<a:ReturnType>List&lt;ClienteCuentaDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    if (!esAdminOCajero(claims)) {
        throw new TransaccionExcepcion(&quot;Acceso denegado&quot;,
                new RespuestaError(&quot;ACCESO_DENEGADO&quot;, &quot;Solo ADMIN o CAJERO pueden consultar clientes.&quot;, &quot;token&quot;));
    }
    try {
        List&lt;ClienteCuentaDTO&gt; resultado = new java.util.ArrayList&lt;&gt;();
        for (UsuarioDTO usuario : usuarioDAO.listar()) {
            // El flujo crea cuentas para titulares de tipo CLIENTE, nunca para
            // cuentas administrativas (ADMIN/CAJERO).
            if (!&quot;CLIENTE&quot;.equalsIgnoreCase(rolNombre(usuario.getRolId()))) continue;
            resultado.add(new ClienteCuentaDTO(usuario.getUsuarioId(),
                    usuario.getUsuarioNombre() + &quot; &quot; + usuario.getUsuarioApellido(),
                    usuario.getUsuarioUsuario()));
        }
        return resultado;
    } catch (SQLException e) {
        throw new TransaccionExcepcion(&quot;Error de base de datos&quot;,
                new RespuestaError(&quot;ERROR_BASE_DATOS&quot;, &quot;No se pudieron consultar los clientes.&quot;, e.getMessage()), e);
    }
}
</a:TemplateBody>
<c:Parameters>
