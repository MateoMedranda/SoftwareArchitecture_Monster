<a:ObjectID>C998BFF3-0A33-4586-B043-E1602AE51119</a:ObjectID>
<a:Name>operacion</a:Name>
<a:Code>operacion</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>DisponibilidadCuentaServicio.Operacion&lt;T&gt;</a:Parameter.DataType>
<c:ObjectDataType>
<o:Interface Ref="o1164"/>
</c:ObjectDataType>
</o:Parameter>
</c:Parameters>
<c:TypeParameters>
