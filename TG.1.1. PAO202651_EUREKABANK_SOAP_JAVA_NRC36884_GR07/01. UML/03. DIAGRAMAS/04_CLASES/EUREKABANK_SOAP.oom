<o:Operation Id="o1281">
<a:ObjectID>5B366773-9EFB-4CB7-9BB7-B20B39483E75</a:ObjectID>
<a:Name>calcularSha256</a:Name>
<a:Code>calcularSha256</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Calcula el hash SHA-256 de un texto y lo retorna como string hexadecimal (64 chars).
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>LoginExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    try {
        MessageDigest digest = MessageDigest.getInstance(&quot;SHA-256&quot;);
        byte[] hashBytes = digest.digest(texto.getBytes(StandardCharsets.UTF_8));

        StringBuilder sb = new StringBuilder();
        for (byte b : hashBytes) {
            sb.append(String.format(&quot;%02x&quot;, b));
        }
        return sb.toString(); // 64 caracteres hex

    } catch (NoSuchAlgorithmException e) {
        // SHA-256 siempre está disponible en Java — este catch es preventivo
        throw new LoginExcepcion(
            &quot;Error interno de cifrado&quot;,
            new RespuestaError(
                &quot;ERROR_CIFRADO&quot;,
                &quot;Error interno al procesar las credenciales. Contacte al administrador.&quot;,
                e.getMessage()
            ),
            e
        );
    }
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,271={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,62=@return Hash SHA-256 en hexadecimal minúsculas (64 caracteres)
{F03653A9-9917-45E2-8F4E-2713C1F58F40},Javadoc@throws,91=@throws LoginExcepcion si el algoritmo SHA-256 no está disponible (nunca debería ocurrir)


</a:ExtendedAttributesText>
