<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Mantiene el UUID como clave interna, permitiendo que el cliente envíe el número público.</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    try {
        String id = cuentaDAO.resolverId(referencia);
        if (id == null) throw error(&quot;CUENTA_NO_ENCONTRADA&quot;, &quot;El número de cuenta indicado no existe.&quot;, &quot;cuentaNumero&quot;);
        return id;
    } catch (SQLException e) {
        throw errorBaseDatos(&quot;No se pudo resolver el número de cuenta.&quot;, e);
    }
}
</a:TemplateBody>
