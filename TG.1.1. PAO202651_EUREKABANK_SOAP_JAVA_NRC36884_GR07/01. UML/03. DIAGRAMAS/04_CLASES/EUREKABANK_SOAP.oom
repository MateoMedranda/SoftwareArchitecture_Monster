<a:TemplateBody>{
    EstadoCuentaDTO estado = new EstadoCuentaDTO();
    estado.setCuentaId(cuentaId);
    estado.setBloqueada(bloqueada);
    estado.setEstado(bloqueada ? &quot;BLOQUEADA&quot; : &quot;DISPONIBLE&quot;);
    estado.setVersion(version);
    return estado;
}
