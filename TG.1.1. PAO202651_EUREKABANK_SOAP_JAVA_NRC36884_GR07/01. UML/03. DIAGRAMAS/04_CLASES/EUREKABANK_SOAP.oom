<o:Operation Id="o98">
<a:ObjectID>51417D67-0C2D-4748-B689-A7BE9D154FBC</a:ObjectID>
<a:Name>generarToken</a:Name>
<a:Code>generarToken</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  API pública
 ─────────────────────────────────────────────────────────────────────────
Genera un token JWT para el usuario autenticado y lo registra en la BDD.
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String jti = UUID.randomUUID().toString();
    Date ahora = new Date();
    Date expiracion = new Date(ahora.getTime() + EXPIRACION_MS);

    String jwt = Jwts.builder()
            .id(jti)
            .subject(usuarioId)
            .claim(&quot;rol&quot;, rolId)
            .issuedAt(ahora)
            .expiration(expiracion)
            .signWith(obtenerClave())
            .compact();

    registrarOActualizarJtiEnBDD(jti, usuarioId);
    LOG.info(&quot;[TokenGenerador] Token generado para usuario: &quot; + usuarioId + &quot; | JTI: &quot; + jti);
    return jwt;
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,236={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,46=@return JWT compacto: header.payload.signature
{F03653A9-9917-45E2-8F4E-2713C1F58F40},Javadoc@throws,72=@throws SQLException si no se puede registrar el JTI en la tabla TOKEN


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o99">
<a:ObjectID>7D8AAAAB-52BA-42D1-B8C2-C86F883D55C8</a:ObjectID>
<a:Name>usuarioId</a:Name>
<a:Code>usuarioId</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>ID del usuario (subject del JWT)</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o100">
<a:ObjectID>A21212F4-5408-4AB6-869D-8454E5DBDA24</a:ObjectID>
<a:Name>rolId</a:Name>
<a:Code>rolId</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>ID del rol del usuario (claim personalizado)</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o101">
<a:ObjectID>68E79ED1-0C7F-4F10-994C-32511C3FF89F</a:ObjectID>
<a:Name>validarToken</a:Name>
<a:Code>validarToken</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Valida un token JWT: verifica firma, expiración y estado activo en BDD.
</a:Comment>
<a:ReturnType>Optional&lt;Claims&gt;</a:ReturnType>
<a:TemplateBody>{
    if (token == null || token.isBlank()) {
        return Optional.empty();
    }
    try {
        Claims claims = Jwts.parser()
                .verifyWith(obtenerClave())
                .build()
                .parseSignedClaims(token)
                .getPayload();

        // Verificar que el JTI no haya sido revocado
        String jti = claims.getId();
        if (!esJtiActivo(jti)) {
            LOG.warning(&quot;[TokenGenerador] Token revocado o no registrado — JTI: &quot; + jti);
            return Optional.empty();
        }
        // Verificar antiguedad (30 min) contra BDD
        if (!esTokenVigente(jti)) {
            LOG.warning(&quot;[TokenGenerador] Token expirado por antiguedad (&gt;30 min) — JTI: &quot; + jti);
            return Optional.empty();
        }
        return Optional.of(claims);

    } catch (ExpiredJwtException e) {
        LOG.warning(&quot;[TokenGenerador] Token expirado.&quot;);
        return Optional.empty();
    } catch (JwtException e) {
        LOG.warning(&quot;[TokenGenerador] Token JWT invalido: &quot; + e.getMessage());
        return Optional.empty();
    }
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,192={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,132=@return Optional con los Claims si el token es completamente válido,
        Optional.empty() si es inválido, expirado o revocado


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o102">
<a:ObjectID>8499559A-D18A-4D85-B34A-71AC64F7AF0F</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>JWT recibido</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o103">
<a:ObjectID>58DEC4EA-0A4E-4630-8F54-185DE2E9EABB</a:ObjectID>
<a:Name>revocarToken</a:Name>
<a:Code>revocarToken</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Revoca un token cambiando su JTI a INACTIVO en la BDD (logout).
</a:Comment>
<a:ReturnType>boolean</a:ReturnType>
<a:TemplateBody>{
    if (token == null || token.isBlank()) {
        return false;
    }
    try {
        // Parsear sin verificar firma para obtener el JTI incluso si ya expiró
        Claims claims = Jwts.parser()
                .verifyWith(obtenerClave())
                .build()
                .parseSignedClaims(token)
                .getPayload();

        String jti = claims.getId();
        boolean revocado = marcarJtiInactivo(jti);
        LOG.info(&quot;[TokenGenerador] Token revocado — JTI: &quot; + jti + &quot; | Exito: &quot; + revocado);
        return revocado;

    } catch (JwtException e) {
        LOG.warning(&quot;[TokenGenerador] No se puede revocar token invalido: &quot; + e.getMessage());
        return false;
    }
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,121={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,62=@return true si se revocó con éxito, false en caso contrario


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o104">
<a:ObjectID>D7EF5758-5A5E-4574-BB80-4A2E16CD190B</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>JWT a revocar</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o105">
<a:ObjectID>F5C8BBBD-CC6B-4856-90A7-B973780D562E</a:ObjectID>
<a:Name>obtenerClave</a:Name>
<a:Code>obtenerClave</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  Métodos privados
 ─────────────────────────────────────────────────────────────────────────
Construye la SecretKey para HMAC-SHA256.
Lee JWT_SECRETO del .development.env; si no existe, usa el secreto por defecto.
La clave se completa a 32 bytes si es más corta.
</a:Comment>
<a:ReturnType>SecretKey</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    String secreto = DotEnvLoader.obtener(&quot;JWT_SECRETO&quot;, SECRETO_DEFECTO);
    byte[] bytes = secreto.getBytes(StandardCharsets.UTF_8);
    // HMAC-SHA256 requiere al menos 256 bits (32 bytes)
    if (bytes.length &lt; 32) {
        bytes = Arrays.copyOf(bytes, 32);
    }
    return Keys.hmacShaKeyFor(bytes);
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o106">
<a:ObjectID>923DA7C0-8081-4DC2-B2A0-DC6477C37DF5</a:ObjectID>
<a:Name>registrarOActualizarJtiEnBDD</a:Name>
<a:Code>registrarOActualizarJtiEnBDD</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String select = &quot;SELECT TOKEN_ID FROM TOKEN WHERE USUARIO_ID = ? LIMIT 1&quot;;
    String update = &quot;UPDATE TOKEN SET TOKEN_TOKEN = ?, TOKEN_ESTADO = &#39;ACTIVO&#39;, TOKEN_CREADO_EN = NOW() WHERE USUARIO_ID = ?&quot;;
    String insert = &quot;INSERT INTO TOKEN (TOKEN_ID, TOKEN_TOKEN, TOKEN_ESTADO, USUARIO_ID, TOKEN_CREADO_EN) VALUES (?, ?, &#39;ACTIVO&#39;, ?, NOW())&quot;;
    try (Connection conn = conexionBDD.getConexion()) {
        try (PreparedStatement ps = conn.prepareStatement(select)) {
            ps.setString(1, usuarioId);
            try (ResultSet rs = ps.executeQuery()) {
                if (rs.next()) {
                    try (PreparedStatement ups = conn.prepareStatement(update)) {
                        ups.setString(1, jti);
                        ups.setString(2, usuarioId);
                        ups.executeUpdate();
                    }
                    return;
                }
            }
        }
        try (PreparedStatement ips = conn.prepareStatement(insert)) {
            ips.setString(1, UUID.randomUUID().toString());
            ips.setString(2, jti);
            ips.setString(3, usuarioId);
            ips.executeUpdate();
        }
    } catch (SQLException e) {
        LOG.severe(&quot;[TokenGenerador] Error al registrar/actualizar JTI en BDD: &quot; + e.getMessage());
        throw e;
    }
}
</a:TemplateBody>
<c:Parameters>
