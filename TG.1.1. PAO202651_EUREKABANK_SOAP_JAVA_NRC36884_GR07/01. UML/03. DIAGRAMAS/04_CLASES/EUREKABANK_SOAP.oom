<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;CuentaDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    try {
        if (esAdminOCajero(claims)) return cuentaDAO.listar();
        // CLIENTE solo asignadas
        List&lt;CuentaDTO&gt; res = new ArrayList&lt;&gt;();
        List&lt;PerteneceDTO&gt; asig = perteneceDAO.listarPorUsuario(claims.getSubject());
        for (PerteneceDTO p : asig) {
            CuentaDTO c = cuentaDAO.obtenerPorId(p.getCuentaId());
            if (c != null) res.add(c);
        }
        return res;
    } catch (SQLException e) { throw new TransaccionExcepcion(&quot;Error de base de datos&quot;, new RespuestaError(&quot;ERROR_BASE_DATOS&quot;,&quot;No se pudo listar las cuentas.&quot;, e.getMessage()), e); }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1218">
<a:ObjectID>7DB12775-8112-4061-ACA0-FFB06DFD3339</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o1219">
<a:ObjectID>E4453947-D8C8-4EB8-B29C-47568804FC71</a:ObjectID>
<a:Name>listarCuentasPorUsuario</a:Name>
<a:Code>listarCuentasPorUsuario</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;CuentaDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    if (!esAdminOCajero(claims) &amp;&amp; !claims.getSubject().equals(usuarioId))
        throw new TransaccionExcepcion(&quot;Acceso denegado&quot;, new RespuestaError(&quot;ACCESO_DENEGADO&quot;,&quot;No puede consultar cuentas de otro usuario.&quot;,&quot;usuarioId&quot;));
    try {
        List&lt;CuentaDTO&gt; res = new ArrayList&lt;&gt;();
        List&lt;PerteneceDTO&gt; asig = perteneceDAO.listarPorUsuario(usuarioId);
        for (PerteneceDTO p : asig) {
            CuentaDTO c = cuentaDAO.obtenerPorId(p.getCuentaId());
            if (c != null) res.add(c);
        }
        return res;
    } catch (SQLException e) { throw new TransaccionExcepcion(&quot;Error de base de datos&quot;, new RespuestaError(&quot;ERROR_BASE_DATOS&quot;,&quot;No se pudo listar las cuentas.&quot;, e.getMessage()), e); }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1220">
<a:ObjectID>682B2942-3DB1-4D12-8031-CB8109DCBE7B</a:ObjectID>
