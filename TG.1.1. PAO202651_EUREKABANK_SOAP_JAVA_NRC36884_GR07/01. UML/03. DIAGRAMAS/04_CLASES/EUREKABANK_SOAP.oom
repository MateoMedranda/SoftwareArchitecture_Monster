<a:Name>obtenerPorIdParaActualizar</a:Name>
<a:Code>obtenerPorIdParaActualizar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Obtiene una cuenta dentro de una transacción ya iniciada y bloquea su fila
hasta que se confirme o revierta dicha transacción.
</a:Comment>
<a:ReturnType>CuentaDTO</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = consultaCuentas() + &quot; WHERE c.CUENTA_ID=? FOR UPDATE&quot;;
    try (PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1, id);
        try (ResultSet rs = ps.executeQuery()) {
            if (rs.next()) return mapear(rs);
        }
    }
    return null;
}
</a:TemplateBody>
