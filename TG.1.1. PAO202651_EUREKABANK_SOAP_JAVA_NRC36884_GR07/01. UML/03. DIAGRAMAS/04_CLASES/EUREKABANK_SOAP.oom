<o:Operation Id="o1189">
<a:ObjectID>D80BE711-3BA5-47BC-8AB0-22ED22E3FF57</a:ObjectID>
<a:Name>validarToken</a:Name>
<a:Code>validarToken</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>Claims</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    try { return TokenFiltro.verificar(token, tokenGenerador); }
    catch (ec.edu.monster.modelos.Respuestas.LoginExcepcion e) { throw new TransaccionExcepcion(e.getMessage(), e.getFaultInfo()); }
}
</a:TemplateBody>
