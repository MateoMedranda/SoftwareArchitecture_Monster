<c:Operations>
<o:Operation Id="o473">
<a:ObjectID>72D8189C-1D08-46DE-AB25-A41521523D70</a:ObjectID>
<a:Name>insertar</a:Name>
<a:Code>insertar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;INSERT INTO CUENTA (CUENTA_ID,CUENTA_NUMERO,SUCURSAL_ID,CUENTA_SALDO,CUENTA_ESTADO) VALUES (?,?,?,?,?)&quot;;
    try (Connection con = conexionBDD.getConexion(); PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1, c.getCuentaId()); ps.setString(2, c.getCuentaNumero()); ps.setString(3, c.getSucursalId());
        ps.setBigDecimal(4, c.getCuentaSaldo()); ps.setString(5, c.getCuentaEstado());
        ps.executeUpdate();
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o474">
<a:ObjectID>DB8A8E30-8111-4503-8C66-B85B40D5E490</a:ObjectID>
<a:Name>c</a:Name>
<a:Code>c</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>CuentaDTO</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o475">
<a:ObjectID>E2DD1A54-494C-4DCB-9D49-7965A8B6BE65</a:ObjectID>
<a:Name>crearYAsignarAutomaticamente</a:Name>
<a:Code>crearYAsignarAutomaticamente</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Crea y asigna una cuenta en una única transacción JDBC. El número público
se deriva en el servidor y se respalda con la restricción UNIQUE de BDD.
</a:Comment>
<a:ReturnType>CuentaDTO</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    SQLException ultimoError = null;
    for (int intento = 0; intento &lt; 5; intento++) {
        try (Connection con = conexionBDD.getConexion()) {
            con.setAutoCommit(false);
            try {
                String sucursalId = obtenerSucursalPredeterminada(con);
                if (sucursalId == null) throw new SQLException(&quot;No existe una sucursal para asignar la cuenta.&quot;);
                String numero = siguienteNumeroPublico(con);
                CuentaDTO cuenta = new CuentaDTO();
                cuenta.setCuentaId(java.util.UUID.randomUUID().toString());
                cuenta.setCuentaNumero(numero);
                cuenta.setSucursalId(sucursalId);
                cuenta.setSucursalNombre(obtenerNombreSucursal(con, sucursalId));
                cuenta.setCuentaSaldo(BigDecimal.ZERO);
                cuenta.setCuentaEstado(&quot;ACTIVA&quot;);
                insertar(con, cuenta);
                try (PreparedStatement ps = con.prepareStatement(
                        &quot;INSERT INTO PERTENECE (CUENTA_ID,USUARIO_ID) VALUES (?,?)&quot;)) {
                    ps.setString(1, cuenta.getCuentaId());
                    ps.setString(2, usuarioId);
                    ps.executeUpdate();
                }
                con.commit();
                return cuenta;
            } catch (SQLException e) {
                con.rollback();
                ultimoError = e;
                if (!esNumeroDuplicado(e)) throw e;
            } finally {
                try { con.setAutoCommit(true); } catch (SQLException ignored) { }
            }
        }
    }
    throw ultimoError == null ? new SQLException(&quot;No fue posible generar un número de cuenta.&quot;) : ultimoError;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o476">
<a:ObjectID>DFE581CC-F29F-45FA-A565-4638A8EA6913</a:ObjectID>
<a:Name>usuarioId</a:Name>
<a:Code>usuarioId</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o477">
<a:ObjectID>4A472059-CAD3-43EE-BDBD-4AC88E62427C</a:ObjectID>
<a:Name>obtenerSucursalPredeterminada</a:Name>
<a:Code>obtenerSucursalPredeterminada</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    try (PreparedStatement ps = con.prepareStatement(
            &quot;SELECT SUCURSAL_ID FROM SUCURSAL ORDER BY SUCURSAL_ID LIMIT 1&quot;);
         ResultSet rs = ps.executeQuery()) {
        return rs.next() ? rs.getString(&quot;SUCURSAL_ID&quot;) : null;
    }
}
</a:TemplateBody>
