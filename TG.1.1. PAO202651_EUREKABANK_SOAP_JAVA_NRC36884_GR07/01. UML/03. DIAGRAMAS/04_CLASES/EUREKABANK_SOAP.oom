</o:Operation>
<o:Operation Id="o109">
<a:ObjectID>33223B24-3488-47E5-804D-C764998EC4F0</a:ObjectID>
<a:Name>esJtiActivo</a:Name>
<a:Code>esJtiActivo</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    String sql = &quot;SELECT TOKEN_ESTADO FROM TOKEN WHERE TOKEN_TOKEN = ?&quot;;
    try (Connection conn = conexionBDD.getConexion();
         PreparedStatement ps = conn.prepareStatement(sql)) {
        ps.setString(1, jti);
        ResultSet rs = ps.executeQuery();
        if (rs.next()) {
            return &quot;ACTIVO&quot;.equalsIgnoreCase(rs.getString(&quot;TOKEN_ESTADO&quot;));
        }
    } catch (SQLException e) {
        LOG.severe(&quot;[TokenGenerador] Error al verificar JTI: &quot; + e.getMessage());
    }
    return false;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o110">
<a:ObjectID>9CC4CD29-F34F-439D-A23C-5B7E12A52A32</a:ObjectID>
<a:Name>jti</a:Name>
<a:Code>jti</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o111">
<a:ObjectID>DB205068-2B2F-47B2-964E-29164E17975A</a:ObjectID>
<a:Name>esTokenVigente</a:Name>
<a:Code>esTokenVigente</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    // La antigüedad se calcula con la hora del servidor de BDD para evitar
    // desfases entre la zona horaria de MySQL y la de Payara.
    String sql = &quot;SELECT TIMESTAMPDIFF(SECOND, TOKEN_CREADO_EN, NOW()) AS EDAD &quot;
               + &quot;FROM TOKEN WHERE TOKEN_TOKEN = ?&quot;;
    try (Connection conn = conexionBDD.getConexion();
         PreparedStatement ps = conn.prepareStatement(sql)) {
        ps.setString(1, jti);
        ResultSet rs = ps.executeQuery();
        if (rs.next()) {
            long edadSegundos = rs.getLong(&quot;EDAD&quot;);
            return edadSegundos &lt;= (EXPIRACION_MS / 1000);
        }
    } catch (SQLException e) {
        LOG.severe(&quot;[TokenGenerador] Error al verificar antiguedad: &quot; + e.getMessage());
    }
    return false;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o112">
<a:ObjectID>EFE693A8-1C06-4E92-8FC6-7102739EE447</a:ObjectID>
<a:Name>jti</a:Name>
<a:Code>jti</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o113">
<a:ObjectID>635FBDB4-BE60-4443-8F11-0F89E26A435A</a:ObjectID>
<a:Name>marcarJtiInactivo</a:Name>
<a:Code>marcarJtiInactivo</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    String sql = &quot;UPDATE TOKEN SET TOKEN_ESTADO = &#39;INACTIVO&#39; WHERE TOKEN_TOKEN = ?&quot;;
    try (Connection conn = conexionBDD.getConexion();
         PreparedStatement ps = conn.prepareStatement(sql)) {
        ps.setString(1, jti);
        return ps.executeUpdate() &gt; 0;
    } catch (SQLException e) {
        LOG.severe(&quot;[TokenGenerador] Error al revocar JTI: &quot; + e.getMessage());
        return false;
    }
}
</a:TemplateBody>
