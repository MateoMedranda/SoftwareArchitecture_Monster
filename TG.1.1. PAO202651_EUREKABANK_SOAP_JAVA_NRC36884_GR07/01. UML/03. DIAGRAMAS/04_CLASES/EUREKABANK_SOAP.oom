<o:Operation Id="o1242">
<a:ObjectID>92C6DC9F-0929-400A-9C91-94C7F9116977</a:ObjectID>
<a:Name>obtenerEstado</a:Name>
<a:Code>obtenerEstado</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>EstadoCuentaDTO</a:ReturnType>
<a:TemplateBody>{
    ReentrantLock bloqueo = bloqueos.computeIfAbsent(cuentaId, id -&gt; new ReentrantLock(true));
    long version = versiones.computeIfAbsent(cuentaId, id -&gt; new AtomicLong(0)).get();
    return crearEstado(cuentaId, bloqueo.isLocked(), version);
}
</a:TemplateBody>
<c:Parameters>
