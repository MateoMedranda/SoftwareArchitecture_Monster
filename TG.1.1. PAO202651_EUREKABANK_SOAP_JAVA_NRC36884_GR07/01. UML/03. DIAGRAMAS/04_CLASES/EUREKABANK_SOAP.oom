<a:ObjectID>E007B2F6-5A27-4B78-910C-0EA1C34F37E5</a:ObjectID>
<a:Name>listarDisponibilidades</a:Name>
<a:Code>listarDisponibilidades</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Devuelve el semáforo temporal de todas las cuentas permitidas al usuario.</a:Comment>
<a:ReturnType>List&lt;EstadoCuentaDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    List&lt;EstadoCuentaDTO&gt; estados = new ArrayList&lt;&gt;();
    for (CuentaDTO cuenta : listarCuentas(token)) {
        estados.add(disponibilidadCuentaServicio.obtenerEstado(cuenta.getCuentaId()));
    }
    return estados;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1231">
<a:ObjectID>7AB88E27-4C21-481F-AFC1-71BD83F381BD</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
