<c:Operations>
<o:Operation Id="o1238">
<a:ObjectID>2609E996-3F29-4279-862A-9B666BBAFF8A</a:ObjectID>
<a:Name>ejecutarExclusivo</a:Name>
<a:Code>ejecutarExclusivo</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>T</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>        {
    List&lt;String&gt; ids = normalizarYOrdenar(cuentaIds);
    List&lt;ReentrantLock&gt; adquiridos = new ArrayList&lt;&gt;();
    try {
        for (String cuentaId : ids) {
            ReentrantLock bloqueo = bloqueos.computeIfAbsent(cuentaId, id -&gt; new ReentrantLock(true));
            bloqueo.lock();
            adquiridos.add(bloqueo);
            publicarCambio(cuentaId);
        }
        return operacion.ejecutar();
    } finally {
        for (int i = adquiridos.size() - 1; i &gt;= 0; i--) {
            String cuentaId = ids.get(i);
            adquiridos.get(i).unlock();
            publicarCambio(cuentaId);
        }
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1239">
<a:ObjectID>177FD4B4-9CDF-4270-81FB-74FD293B3ABF</a:ObjectID>
