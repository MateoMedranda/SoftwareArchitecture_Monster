<o:Operation Id="o1244">
<a:ObjectID>34E3ED56-12EB-46B2-8CBD-6BF41FADBD49</a:ObjectID>
<a:Name>esperarCambio</a:Name>
<a:Code>esperarCambio</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Espera, como máximo, treinta segundos a que cambie la versión de una
cuenta. Si no hay cambio, devuelve el estado actual para que el cliente
SOAP pueda volver a consultar sin perder conectividad.
</a:Comment>
<a:ReturnType>EstadoCuentaDTO</a:ReturnType>
<a:Operation.Throws>InterruptedException</a:Operation.Throws>
<a:TemplateBody>        {
    long espera = Math.max(0L, Math.min(esperaMaximaMs, 30_000L));
    long limite = System.currentTimeMillis() + espera;
    synchronized (monitorCambios) {
        while (versionActual(cuentaId) &lt;= versionConocida) {
            long restante = limite - System.currentTimeMillis();
            if (restante &lt;= 0) break;
            monitorCambios.wait(restante);
        }
    }
    return obtenerEstado(cuentaId);
}
</a:TemplateBody>
<c:Parameters>
