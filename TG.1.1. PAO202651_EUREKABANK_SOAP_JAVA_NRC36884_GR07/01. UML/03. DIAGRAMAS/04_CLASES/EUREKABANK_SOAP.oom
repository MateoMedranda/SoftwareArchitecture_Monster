<o:Operation Id="o82">
<a:ObjectID>5288242C-D72C-4E90-AC26-1BDFB99467E2</a:ObjectID>
<a:Name>unmarshal</a:Name>
<a:Code>unmarshal</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>LocalDateTime</a:ReturnType>
<a:TemplateBody>{
    return valor == null || valor.isBlank() ? null : LocalDateTime.parse(valor, FORMATO);
}
</a:TemplateBody>
