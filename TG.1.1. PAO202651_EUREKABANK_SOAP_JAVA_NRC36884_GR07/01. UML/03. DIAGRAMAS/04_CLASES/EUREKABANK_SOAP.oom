<o:Operation Id="o511">
<a:ObjectID>7F05B79A-F784-47BB-91E7-C87AA6C4C30A</a:ObjectID>
<a:Name>consultaCuentas</a:Name>
<a:Code>consultaCuentas</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    return &quot;SELECT c.CUENTA_ID,c.CUENTA_NUMERO,c.SUCURSAL_ID,c.CUENTA_SALDO,c.CUENTA_ESTADO,&quot;
            + &quot;s.SUCURSAL_NOMBRE FROM CUENTA c LEFT JOIN SUCURSAL s ON s.SUCURSAL_ID=c.SUCURSAL_ID&quot;;
}
</a:TemplateBody>
</o:Operation>
</c:Operations>
