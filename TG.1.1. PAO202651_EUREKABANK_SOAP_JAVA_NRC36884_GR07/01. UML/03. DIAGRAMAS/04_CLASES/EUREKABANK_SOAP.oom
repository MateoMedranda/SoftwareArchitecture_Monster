<o:Operation Id="o1439">
<a:ObjectID>C982C8F0-5679-43F5-862D-B60B4D0D28B8</a:ObjectID>
<a:Name>listarUsuarios</a:Name>
<a:Code>listarUsuarios</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;UsuarioDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    if (!esAdminOCajero(claims)) throw new TransaccionExcepcion(&quot;Acceso denegado&quot;, new RespuestaError(&quot;ACCESO_DENEGADO&quot;,&quot;Solo ADMIN o CAJERO pueden listar usuarios.&quot;,&quot;token&quot;));
    try {
        List&lt;UsuarioDTO&gt; lista = usuarioDAO.listar();
        for (UsuarioDTO u : lista) u.setUsuarioContraseania(null);
        return lista;
    } catch (SQLException e) { throw new TransaccionExcepcion(&quot;Error de base de datos&quot;, new RespuestaError(&quot;ERROR_BASE_DATOS&quot;,&quot;No se pudo listar los usuarios.&quot;, e.getMessage()), e); }
}
</a:TemplateBody>
