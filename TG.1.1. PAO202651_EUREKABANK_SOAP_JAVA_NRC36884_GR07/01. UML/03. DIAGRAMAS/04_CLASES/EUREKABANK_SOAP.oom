<o:Operation Id="o1225">
<a:ObjectID>593B3B0E-7F53-46CF-9818-6EE2512AC9E9</a:ObjectID>
<a:Name>esperarCambioDisponibilidad</a:Name>
<a:Code>esperarCambioDisponibilidad</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Long polling SOAP para notificar a clientes cuando cambia la disponibilidad.</a:Comment>
<a:ReturnType>EstadoCuentaDTO</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>        {
    // obtenerDisponibilidad también valida token, formato y autorización.
    EstadoCuentaDTO estado = obtenerDisponibilidad(token, cuentaId);
    try {
        return disponibilidadCuentaServicio.esperarCambio(estado.getCuentaId(), versionConocida, esperaMaximaMs);
    } catch (InterruptedException e) {
        Thread.currentThread().interrupt();
        throw new TransaccionExcepcion(&quot;Espera interrumpida&quot;, new RespuestaError(
                &quot;ESPERA_INTERRUMPIDA&quot;, &quot;La espera del cambio de disponibilidad fue interrumpida.&quot;, &quot;cuentaId&quot;), e);
    }
}
</a:TemplateBody>
