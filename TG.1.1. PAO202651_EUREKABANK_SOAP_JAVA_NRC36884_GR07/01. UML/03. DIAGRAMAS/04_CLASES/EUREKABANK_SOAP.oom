<o:Operation Id="o498">
<a:ObjectID>1BCAD20F-174D-4933-BFB4-DCAE12E700A1</a:ObjectID>
<a:Name>listar</a:Name>
<a:Code>listar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;CuentaDTO&gt;</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    List&lt;CuentaDTO&gt; lista = new ArrayList&lt;&gt;();
    String sql = consultaCuentas();
    try (Connection con = conexionBDD.getConexion(); Statement st = con.createStatement(); ResultSet rs = st.executeQuery(sql)) {
        while (rs.next()) lista.add(mapear(rs));
    }
    return lista;
}
</a:TemplateBody>
</o:Operation>
