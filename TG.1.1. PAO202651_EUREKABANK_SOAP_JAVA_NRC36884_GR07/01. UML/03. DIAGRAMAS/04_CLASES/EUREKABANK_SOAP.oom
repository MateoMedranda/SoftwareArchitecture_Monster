<o:Operation Id="o1433">
<a:ObjectID>B7B732EC-7464-4644-9D22-5BDD0FFF6F57</a:ObjectID>
<a:Name>eliminarUsuario</a:Name>
<a:Code>eliminarUsuario</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    if (!esAdmin(claims)) throw new TransaccionExcepcion(&quot;Acceso denegado&quot;, new RespuestaError(&quot;ACCESO_DENEGADO&quot;,&quot;Solo ADMIN puede eliminar usuarios.&quot;,&quot;token&quot;));
    try { usuarioDAO.eliminar(usuarioId); return true; }
    catch (SQLException e) { throw new TransaccionExcepcion(&quot;Error de base de datos&quot;, new RespuestaError(&quot;ERROR_BASE_DATOS&quot;,&quot;No se pudo eliminar el usuario.&quot;, e.getMessage()), e); }
}
