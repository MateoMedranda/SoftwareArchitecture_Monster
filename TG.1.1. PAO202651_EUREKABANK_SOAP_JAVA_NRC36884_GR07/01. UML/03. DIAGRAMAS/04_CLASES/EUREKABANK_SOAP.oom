<o:Class Id="o140">
<a:ObjectID>8E6BDBD4-D697-4F2C-A1BE-9AAB41C0A6FD</a:ObjectID>
<a:Name>TokenFiltro</a:Name>
<a:Code>TokenFiltro</a:Code>
<a:CreationDate>1793843408</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843408</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Filtro/helper de validación de tokens JWT para servicios SOAP protegidos.

Esta clase provee métodos estáticos reutilizables para verificar
la autenticidad y permisos de un token JWT antes de ejecutar
la lógica de negocio de cualquier operación SOAP protegida.

Patrón de uso en un servicio SOAP protegido:
&lt;pre&gt;
  {@literal @}EJB
  private TokenGenerador tokenGenerador;

  {@literal @}WebMethod
  public MiRespuesta miOperacion(String token, ...) throws LoginExcepcion {
      // Verificar token — lanza LoginExcepcion si no es válido
      Claims claims = TokenFiltro.verificar(token, tokenGenerador);

      // Opcional: verificar rol específico
      // Claims claims = TokenFiltro.verificarConRol(token, &quot;ADMIN&quot;, tokenGenerador);

      // Obtener ID del usuario del token
      String usuarioId = claims.getSubject();
      String rolId     = claims.get(&quot;rol&quot;, String.class);

      // ... lógica de negocio protegida ...
  }
&lt;/pre&gt;
</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Final>1</a:Final>
<a:Classifier.Header> </a:Classifier.Header>
<a:Imports>import ec.edu.monster.configuracion.TokenGenerador;
import ec.edu.monster.modelos.Respuestas.LoginExcepcion;
import ec.edu.monster.modelos.Respuestas.RespuestaError;
import io.jsonwebtoken.Claims;
import java.util.Optional;
</a:Imports>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,81={BCE16AEA-6699-4EBE-A32C-82226C6E17D0},Javadoc@author,22=@author MONSTER GR07


</a:ExtendedAttributesText>
<c:Operations>
<o:Operation Id="o298">
<a:ObjectID>C97D90F2-E354-4EAB-B746-B45347CB58A5</a:ObjectID>
<a:Name>TokenFiltro</a:Name>
<a:Code>TokenFiltro</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Stereotype>Constructor</a:Stereotype>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    // Clase utilitaria — no instanciar
}
</a:TemplateBody>
<c:InfluentObject>
<o:Class Ref="o140"/>
</c:InfluentObject>
</o:Operation>
<o:Operation Id="o299">
<a:ObjectID>E202BE17-74AF-49E9-BCF2-919638AD25BD</a:ObjectID>
<a:Name>verificar</a:Name>
<a:Code>verificar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  API pública
 ─────────────────────────────────────────────────────────────────────────
Verifica que el token JWT sea válido y esté activo en la BDD.
</a:Comment>
<a:ReturnType>Claims</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:Operation.Throws>LoginExcepcion</a:Operation.Throws>
<a:TemplateBody>        {

    if (token == null || token.trim().isEmpty()) {
        throw new LoginExcepcion(
            &quot;Token de autenticacion no proporcionado&quot;,
            new RespuestaError(
                &quot;TOKEN_REQUERIDO&quot;,
                &quot;Se requiere un token de autenticación para acceder a esta operación. &quot; +
                &quot;Por favor, inicie sesión primero.&quot;,
                null
            )
        );
    }

    Optional&lt;Claims&gt; optClaims = tokenGenerador.validarToken(token.trim());

    if (optClaims.isEmpty()) {
        throw new LoginExcepcion(
            &quot;Token invalido, expirado o revocado&quot;,
            new RespuestaError(
                &quot;TOKEN_INVALIDO&quot;,
                &quot;El token proporcionado es inválido, ha expirado o fue revocado. &quot; +
                &quot;Por favor, inicie sesión nuevamente.&quot;,
                null
            )
        );
    }

    return optClaims.get();
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,318={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,37=@return Claims del token si es válido
{F03653A9-9917-45E2-8F4E-2713C1F58F40},Javadoc@throws,162=@throws LoginExcepcion con código TOKEN_REQUERIDO si el token es nulo/vacío
@throws LoginExcepcion con código TOKEN_INVALIDO si el token es inválido o expirado


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o300">
<a:ObjectID>105898C6-E023-47FB-BA60-D81CE72B33F9</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Token JWT recibido en la petición SOAP</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o301">
<a:ObjectID>D05B659D-0941-4F62-86D4-629C43E8BBCC</a:ObjectID>
<a:Name>tokenGenerador</a:Name>
<a:Code>tokenGenerador</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Instancia del EJB TokenGenerador (inyectada por el servicio)</a:Comment>
<a:Parameter.DataType>TokenGenerador</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o302">
<a:ObjectID>A9689874-8CAE-4534-B310-42BE8A095427</a:ObjectID>
<a:Name>verificarConRol</a:Name>
<a:Code>verificarConRol</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Verifica el token y además comprueba que el usuario tenga el rol requerido.
</a:Comment>
<a:ReturnType>Claims</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:Operation.Throws>LoginExcepcion</a:Operation.Throws>
<a:TemplateBody>        {

    Claims claims = verificar(token, tokenGenerador);

    if (rolRequerido != null &amp;&amp; !rolRequerido.isBlank()) {
        String rolDelToken = claims.get(&quot;rol&quot;, String.class);
        if (!rolRequerido.equals(rolDelToken)) {
            throw new LoginExcepcion(
                &quot;Acceso denegado — rol insuficiente&quot;,
                new RespuestaError(
                    &quot;ACCESO_DENEGADO&quot;,
                    &quot;No tiene los permisos necesarios para realizar esta operación.&quot;,
                    &quot;Rol requerido: &quot; + rolRequerido
                )
            );
        }
    }

    return claims;
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,432={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,62=@return Claims del token si es válido y tiene el rol requerido
{F03653A9-9917-45E2-8F4E-2713C1F58F40},Javadoc@throws,251=@throws LoginExcepcion con código TOKEN_REQUERIDO si el token es nulo/vacío
@throws LoginExcepcion con código TOKEN_INVALIDO si el token es inválido o expirado
@throws LoginExcepcion con código ACCESO_DENEGADO si el token no tiene el rol requerido


</a:ExtendedAttributesText>
