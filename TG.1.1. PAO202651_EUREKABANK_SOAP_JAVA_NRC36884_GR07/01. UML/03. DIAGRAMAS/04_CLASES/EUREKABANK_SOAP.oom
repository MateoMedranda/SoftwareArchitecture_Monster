<a:Name>obtenerCuentaActivaParaActualizar</a:Name>
<a:Code>obtenerCuentaActivaParaActualizar</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>CuentaDTO</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>SQLException, TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>        {
    CuentaDTO cuenta = cuentaDAO.obtenerPorIdParaActualizar(conexion, cuentaId);
    if (cuenta == null) {
        throw error(&quot;CUENTA_NO_ENCONTRADA&quot;, &quot;La cuenta indicada no existe.&quot;, &quot;cuentaId&quot;);
    }
    if (!&quot;ACTIVA&quot;.equalsIgnoreCase(cuenta.getCuentaEstado())) {
        throw error(&quot;CUENTA_INACTIVA&quot;, &quot;La cuenta no está activa.&quot;, &quot;cuentaId&quot;);
    }
    return cuenta;
}
</a:TemplateBody>
<c:Parameters>
