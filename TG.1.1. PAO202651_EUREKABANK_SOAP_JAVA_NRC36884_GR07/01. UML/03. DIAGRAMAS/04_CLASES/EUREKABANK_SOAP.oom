<o:Operation Id="o1198">
<a:ObjectID>3DB2715D-09A8-45B1-91FF-B7495E568C6B</a:ObjectID>
<a:Name>resolverCuentaId</a:Name>
<a:Code>resolverCuentaId</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Convierte el número público de diez dígitos en el UUID interno.</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    try {
        String id = cuentaDAO.resolverId(referencia);
        if (id == null) throw new TransaccionExcepcion(&quot;No encontrada&quot;,
                new RespuestaError(&quot;CUENTA_NO_ENCONTRADA&quot;, &quot;El número de cuenta indicado no existe.&quot;, &quot;cuentaNumero&quot;));
        return id;
    } catch (SQLException e) {
        throw new TransaccionExcepcion(&quot;Error de base de datos&quot;,
                new RespuestaError(&quot;ERROR_BASE_DATOS&quot;, &quot;No se pudo resolver el número de cuenta.&quot;, e.getMessage()), e);
    }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1199">
<a:ObjectID>156F7EE6-A17A-49C8-B08B-5CC3D4A1D259</a:ObjectID>
