<a:TemplateBody>{
    try {
        RolDTO rol = rolDAO.obtenerPorId(rolId);
        return rol == null ? &quot;&quot; : rol.getRolNombre();
    } catch (SQLException e) {
        return &quot;&quot;;
    }
}
