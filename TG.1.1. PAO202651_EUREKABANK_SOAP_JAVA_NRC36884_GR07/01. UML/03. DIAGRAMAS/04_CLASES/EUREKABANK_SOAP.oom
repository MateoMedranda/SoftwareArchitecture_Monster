<a:Name>normalizarYOrdenar</a:Name>
<a:Code>normalizarYOrdenar</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;String&gt;</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    if (cuentaIds == null || cuentaIds.isEmpty()) {
        throw new TransaccionExcepcion(&quot;Cuenta requerida&quot;, null);
    }
    Set&lt;String&gt; unicos = new HashSet&lt;&gt;();
    for (String cuentaId : cuentaIds) {
        if (cuentaId == null || cuentaId.trim().isEmpty()) {
            throw new TransaccionExcepcion(&quot;Cuenta requerida&quot;, null);
        }
        unicos.add(cuentaId.trim());
    }
    List&lt;String&gt; ids = new ArrayList&lt;&gt;(unicos);
    ids.sort(Comparator.naturalOrder());
    return ids;
}
</a:TemplateBody>
