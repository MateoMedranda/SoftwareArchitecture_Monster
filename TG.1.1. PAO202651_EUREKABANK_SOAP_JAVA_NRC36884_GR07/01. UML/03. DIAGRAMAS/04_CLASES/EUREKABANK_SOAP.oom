<o:Operation Id="o501">
<a:ObjectID>9443F370-D2DF-4121-8681-83B571C77EE1</a:ObjectID>
<a:Name>actualizarSaldo</a:Name>
<a:Code>actualizarSaldo</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Actualiza exclusivamente el saldo dentro de la transacción del llamador.</a:Comment>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;UPDATE CUENTA SET CUENTA_SALDO=? WHERE CUENTA_ID=?&quot;;
    try (PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setBigDecimal(1, saldo);
        ps.setString(2, cuentaId);
        if (ps.executeUpdate() != 1) {
            throw new SQLException(&quot;No se pudo actualizar el saldo de la cuenta &quot; + cuentaId);
        }
    }
}
</a:TemplateBody>
