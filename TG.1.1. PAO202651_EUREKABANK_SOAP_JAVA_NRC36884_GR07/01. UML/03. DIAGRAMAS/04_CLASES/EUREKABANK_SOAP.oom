<o:Operation Id="o493">
<a:ObjectID>24F281DA-A916-4567-A21F-E7F76F8D832A</a:ObjectID>
<a:Name>resolverId</a:Name>
<a:Code>resolverId</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Acepta temporalmente UUID interno o número público para compatibilidad SOAP.</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    if (referencia == null || referencia.trim().isEmpty()) return null;
    String valor = referencia.trim();
    CuentaDTO cuenta = obtenerPorId(valor);
    if (cuenta == null) cuenta = obtenerPorNumero(valor);
    return cuenta == null ? null : cuenta.getCuentaId();
}
</a:TemplateBody>
