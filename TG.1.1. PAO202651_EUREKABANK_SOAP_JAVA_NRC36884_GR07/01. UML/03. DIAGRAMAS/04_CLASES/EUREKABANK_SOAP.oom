<o:Operation Id="o1364">
<a:ObjectID>074DA113-7CA2-42F9-9E4E-86E5351F6EED</a:ObjectID>
<a:Name>listarTransacciones</a:Name>
<a:Code>listarTransacciones</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>List&lt;TransaccionDTO&gt;</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    try {
        List&lt;TransaccionDTO&gt; todas = transaccionDAO.listar();
        if (esAdminOCajero(claims)) return todas;
        List&lt;TransaccionDTO&gt; propias = new ArrayList&lt;&gt;();
        for (TransaccionDTO transaccion : todas) {
            if (cuentaAsignada(transaccion.getCuentaId(), claims.getSubject())) propias.add(transaccion);
        }
        return propias;
    } catch (SQLException e) {
        throw errorBaseDatos(&quot;No se pudo listar las transacciones.&quot;, e);
    }
}
</a:TemplateBody>
