<a:Name>cuentaAsignada</a:Name>
<a:Code>cuentaAsignada</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:TemplateBody>{
    try {
        for (PerteneceDTO asignacion : perteneceDAO.listarPorUsuario(usuarioId)) {
            if (cuentaId.equals(asignacion.getCuentaId())) return true;
        }
    } catch (SQLException ignored) {
        // La operación será denegada si no se puede probar la pertenencia.
    }
    return false;
}
</a:TemplateBody>
