<a:Operation.Throws>SQLException</a:Operation.Throws>
<a:TemplateBody>{
    String sql = &quot;INSERT INTO PERTENECE (CUENTA_ID,USUARIO_ID) VALUES (?,?)&quot;;
    try (Connection con = conexionBDD.getConexion(); PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1, p.getCuentaId()); ps.setString(2, p.getUsuarioId());
        ps.executeUpdate();
    }
}
