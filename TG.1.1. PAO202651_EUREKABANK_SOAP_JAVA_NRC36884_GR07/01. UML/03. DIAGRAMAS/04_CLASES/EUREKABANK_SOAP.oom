    String sql = &quot;DELETE FROM CUENTA WHERE CUENTA_ID=?&quot;;
    try (Connection con = conexionBDD.getConexion(); PreparedStatement ps = con.prepareStatement(sql)) {
        ps.setString(1, id); ps.executeUpdate();
    }
}
