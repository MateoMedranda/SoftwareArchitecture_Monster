<o:Operation Id="o71">
<a:ObjectID>AE8DB867-14BD-44CC-BA40-69A53DEAB66E</a:ObjectID>
<a:Name>cargar</a:Name>
<a:Code>cargar</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  API pública
 ─────────────────────────────────────────────────────────────────────────
Retorna el mapa completo de propiedades del archivo .development.env.
La carga es lazy y thread-safe; el resultado queda en caché.</a:Comment>
<a:ReturnType>Map&lt;String, String&gt;</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    if (valores == null) {
        synchronized (DotEnvLoader.class) {
            if (valores == null) {
                valores = leerArchivo();
            }
        }
    }
    return Collections.unmodifiableMap(valores);
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,67={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,9=@return


</a:ExtendedAttributesText>
</o:Operation>
<o:Operation Id="o72">
<a:ObjectID>90F924F1-4214-4778-8675-7D8385DFB08D</a:ObjectID>
<a:Name>obtener</a:Name>
<a:Code>obtener</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Obtiene el valor de una clave, retornando {@code null} si no existe.
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    return obtener(clave, null);
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,81={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,22=@return valor o null


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o73">
<a:ObjectID>1000E4D8-220E-4D1B-9CB0-3A8265746CE4</a:ObjectID>
<a:Name>clave</a:Name>
<a:Code>clave</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Nombre de la variable (p.ej. &quot;MYSQL_HOST&quot;)</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o74">
<a:ObjectID>B87432CC-1D9D-4944-964C-0A29F600742D</a:ObjectID>
<a:Name>obtener</a:Name>
<a:Code>obtener</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Obtiene el valor de una clave con valor por defecto.
Orden de prioridad: archivo .env → variable OS → propiedad JVM → defecto.
</a:Comment>
<a:ReturnType>String</a:ReturnType>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    cargar();

    // 1. Archivo .env
    String valor = valores.get(clave);
    // 2. Variable de entorno del SO
    if (valor == null) valor = System.getenv(clave);
    // 3. Propiedad JVM (-Dclave=valor)
    if (valor == null) valor = System.getProperty(clave);
    // 4. Valor por defecto
    return valor != null ? valor : valorDefecto;
}
</a:TemplateBody>
<a:ExtendedAttributesText>{0DEDDB90-46E2-45A0-886E-411709DA0DC9},Java,100={1D4C2EF4-615A-4148-85BD-47ECAC4BD1CC},Javadoc@return,41=@return valor encontrado o valorDefecto


</a:ExtendedAttributesText>
<c:Parameters>
<o:Parameter Id="o75">
<a:ObjectID>FAC9EEFC-C4A2-499C-8C60-87FCD4B43841</a:ObjectID>
<a:Name>clave</a:Name>
<a:Code>clave</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Nombre de la variable</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o76">
<a:ObjectID>D0394E82-7293-415F-B13D-0C3E815EB679</a:ObjectID>
<a:Name>valorDefecto</a:Name>
<a:Code>valorDefecto</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment>Valor a retornar si no se encuentra en ninguna fuente</a:Comment>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
</c:Parameters>
</o:Operation>
<o:Operation Id="o77">
<a:ObjectID>3B14649E-6CED-48AD-B429-CA10E07E2720</a:ObjectID>
<a:Name>leerArchivo</a:Name>
<a:Code>leerArchivo</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Comment> ─────────────────────────────────────────────────────────────────────────
  Métodos privados
 ─────────────────────────────────────────────────────────────────────────</a:Comment>
<a:ReturnType>Map&lt;String, String&gt;</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    Map&lt;String, String&gt; mapa = new HashMap&lt;&gt;();
    File archivo = encontrarArchivo();

    if (archivo == null || !archivo.exists()) {
        // Intentar classpath
        try (java.io.InputStream is = DotEnvLoader.class.getResourceAsStream(&quot;/&quot; + NOMBRE_ARCHIVO)) {
            if (is != null) {
                LOG.info(&quot;[DotEnvLoader] Cargando configuracion desde classpath: /&quot; + NOMBRE_ARCHIVO);
                return leerDesdeInputStream(is);
            }
        } catch (IOException e) {
            LOG.severe(&quot;[DotEnvLoader] Error al leer classpath: &quot; + e.getMessage());
        }
        LOG.warning(&quot;[DotEnvLoader] Archivo &quot; + NOMBRE_ARCHIVO
                + &quot; no encontrado. Usando variables del sistema.&quot;);
        return mapa;
    }

    LOG.info(&quot;[DotEnvLoader] Cargando configuracion desde: &quot; + archivo.getAbsolutePath());

    try (BufferedReader lector = new BufferedReader(
            new FileReader(archivo, StandardCharsets.UTF_8))) {

        String linea;
        while ((linea = lector.readLine()) != null) {
            linea = linea.trim();
            // Ignorar líneas vacías y comentarios
            if (linea.isEmpty() || linea.startsWith(&quot;#&quot;)) continue;

            int idx = linea.indexOf(&#39;=&#39;);
            if (idx &gt; 0) {
                String clave = linea.substring(0, idx).trim();
                String valor = linea.substring(idx + 1).trim();
                mapa.put(clave, valor);
            }
        }
        LOG.info(&quot;[DotEnvLoader] &quot; + mapa.size() + &quot; variables cargadas.&quot;);

    } catch (IOException e) {
        LOG.severe(&quot;[DotEnvLoader] Error al leer &quot; + archivo.getAbsolutePath()
                + &quot;: &quot; + e.getMessage());
    }
    return mapa;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o78">
<a:ObjectID>20695DB2-C267-4E13-93B2-FDA1944AAB57</a:ObjectID>
<a:Name>encontrarArchivo</a:Name>
<a:Code>encontrarArchivo</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>File</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:TemplateBody>{
    // 1. Propiedad del sistema ENV_FILE (configurable en Payara JVM Options)
    String ruta = System.getProperty(&quot;ENV_FILE&quot;);
    if (ruta != null) {
        File f = new File(ruta);
        if (f.exists()) return f;
    }

    // 2. Variable de entorno ENV_FILE
    ruta = System.getenv(&quot;ENV_FILE&quot;);
    if (ruta != null) {
        File f = new File(ruta);
        if (f.exists()) return f;
    }

    // 3. Directorio de trabajo actual del servidor
    File f = new File(System.getProperty(&quot;user.dir&quot;), NOMBRE_ARCHIVO);
    if (f.exists()) return f;

    // 4. Directorio padre del directorio de trabajo
    File padre = new File(System.getProperty(&quot;user.dir&quot;)).getParentFile();
    if (padre != null) {
        f = new File(padre, NOMBRE_ARCHIVO);
        if (f.exists()) return f;
    }

    LOG.warning(&quot;[DotEnvLoader] No se encontro el archivo en ninguna ubicacion conocida.&quot;);
    return null;
}
</a:TemplateBody>
</o:Operation>
<o:Operation Id="o79">
<a:ObjectID>7CF283CF-CFFE-413B-B3DB-72369D1205D0</a:ObjectID>
<a:Name>leerDesdeInputStream</a:Name>
<a:Code>leerDesdeInputStream</a:Code>
<a:CreationDate>1793843409</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843409</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>Map&lt;String, String&gt;</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Static>1</a:Operation.Static>
<a:Operation.Throws>IOException</a:Operation.Throws>
<a:TemplateBody>{
    Map&lt;String, String&gt; mapa = new HashMap&lt;&gt;();
    try (java.io.BufferedReader lector = new java.io.BufferedReader(
            new java.io.InputStreamReader(is, StandardCharsets.UTF_8))) {
        String linea;
        while ((linea = lector.readLine()) != null) {
            linea = linea.trim();
            if (linea.isEmpty() || linea.startsWith(&quot;#&quot;)) continue;
            int idx = linea.indexOf(&#39;=&#39;);
            if (idx &gt; 0) {
                String clave = linea.substring(0, idx).trim();
                String valor = linea.substring(idx + 1).trim();
                mapa.put(clave, valor);
            }
        }
    }
    LOG.info(&quot;[DotEnvLoader] &quot; + mapa.size() + &quot; variables cargadas desde classpath.&quot;);
    return mapa;
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o80">
<a:ObjectID>57DCFDA5-A7DA-4FB5-924B-72595B98E735</a:ObjectID>
