<a:ObjectID>8E2165DE-C17F-4C1C-A0B8-42F657293E91</a:ObjectID>
<a:Name>validarTipoYMonto</a:Name>
<a:Code>validarTipoYMonto</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>void</a:ReturnType>
<a:Operation.Visibility>-</a:Operation.Visibility>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    if (tipo == null || tipo.trim().isEmpty()) {
        throw error(&quot;CAMPO_REQUERIDO&quot;, &quot;El campo &#39;tipo&#39; es obligatorio.&quot;, &quot;tipo&quot;);
    }
    String tipoNormalizado = tipo.trim().toUpperCase();
    if (!&quot;INGRESO&quot;.equals(tipoNormalizado) &amp;&amp; !&quot;RETIRO&quot;.equals(tipoNormalizado)) {
        throw error(&quot;TIPO_INVALIDO&quot;, &quot;El tipo debe ser INGRESO o RETIRO.&quot;, &quot;tipo&quot;);
    }
    validarCuentaYMonto(cuentaId, monto);
}
</a:TemplateBody>
<c:Parameters>
