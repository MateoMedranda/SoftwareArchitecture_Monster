<o:Operation Id="o1211">
<a:ObjectID>909A919D-0B21-470C-AE99-ADA01D39B0F1</a:ObjectID>
<a:Name>eliminarCuenta</a:Name>
<a:Code>eliminarCuenta</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:ReturnType>boolean</a:ReturnType>
<a:Operation.Throws>TransaccionExcepcion</a:Operation.Throws>
<a:TemplateBody>{
    Claims claims = validarToken(token);
    String rn = rolNombre(claims.get(&quot;rol&quot;, String.class));
    if (!rn.equals(&quot;ADMIN&quot;)) throw new TransaccionExcepcion(&quot;Acceso denegado&quot;, new RespuestaError(&quot;ACCESO_DENEGADO&quot;,&quot;Solo ADMIN puede eliminar cuentas.&quot;,&quot;token&quot;));
    try { cuentaDAO.eliminar(cuentaId); return true; }
    catch (SQLException e) { throw new TransaccionExcepcion(&quot;Error de base de datos&quot;, new RespuestaError(&quot;ERROR_BASE_DATOS&quot;,&quot;No se pudo eliminar la cuenta.&quot;, e.getMessage()), e); }
}
</a:TemplateBody>
<c:Parameters>
<o:Parameter Id="o1212">
<a:ObjectID>06FF6FB0-E9FB-4AC8-A843-5B6111D45EED</a:ObjectID>
<a:Name>token</a:Name>
<a:Code>token</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
<a:Parameter.DataType>String</a:Parameter.DataType>
</o:Parameter>
<o:Parameter Id="o1213">
<a:ObjectID>929DFCC8-78C3-4EFD-82D2-BE75B43304DD</a:ObjectID>
<a:Name>cuentaId</a:Name>
<a:Code>cuentaId</a:Code>
<a:CreationDate>1793843410</a:CreationDate>
<a:Creator>USER</a:Creator>
<a:ModificationDate>1793843410</a:ModificationDate>
<a:Modifier>USER</a:Modifier>
