# Copie este archivo como .development.env y ajuste los valores para su entorno.
# Estos valores son únicamente para el entorno local definido en docker-compose.yml.
MYSQL_HOST=mysql
MYSQL_PUERTO=3306
MYSQL_DATABASE=arquitectura_db
MYSQL_USER=MONSTER
MYSQL_PASSWORD=MONSTER9
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_USE_SSL=false
# Ejemplo para BDD desplegada en Render (MySQL gratuito, efimera + re-seed):
# MYSQL_HOST=<host-publico-render>
# MYSQL_PUERTO=<puerto-asignado-render>
# MYSQL_DATABASE=arquitectura_db
# MYSQL_USER=MONSTER
# MYSQL_PASSWORD=<secreto-render>
# MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
# MYSQL_USE_SSL=true
