# Copie este archivo como .development.env y ajuste los valores para su entorno.
# Los valores por defecto apuntan a la BDD MySQL en AWS RDS (o al MySQL de docker-compose.yml si usa MYSQL_HOST=mysql).
MYSQL_HOST=mysql #Reemplazar por host aws
MYSQL_PUERTO=3306
MYSQL_DATABASE=arquitectura_db
MYSQL_USER=MONSTER
MYSQL_PASSWORD=MONSTER9
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_SSL_MODE=REQUIRED
# Opcional: keystore de cliente (file:/...). Si se omite, la aplicacion genera
# uno vacio para evitar que Payara envie su certificado y RDS lo rechace.
# MYSQL_CLIENT_KEYSTORE_URL=file:/ruta/cliente.p12
MYSQL_CONN_TIMEOUT=10000
MYSQL_SOCKET_TIMEOUT=30000
# Pool de conexiones (HikariCP). Con 5 clientes simultáneos alcanza con 5-6.
MYSQL_POOL_MAX=5
MYSQL_POOL_MIN=2
MYSQL_POOL_IDLE_TIMEOUT=300000
MYSQL_POOL_MAX_LIFETIME=1500000
MYSQL_POOL_KEEPALIVE=120000
# Ejemplo para BDD desplegada en Render (MySQL gratuito, efimera + re-seed):
# MYSQL_HOST=<host-publico-render>
# MYSQL_PUERTO=<puerto-asignado>
# MYSQL_DATABASE=arquitectura_db
# MYSQL_USER=MONSTER
# MYSQL_PASSWORD=<secreto-render>
# MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
# MYSQL_SSL_MODE=REQUIRED
