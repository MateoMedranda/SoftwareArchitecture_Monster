# Copie este archivo como .development.env y ajuste los valores para su entorno.
# Estos valores son únicamente para el entorno local definido en docker-compose.yml.
MYSQL_HOST=mysql
MYSQL_PUERTO=3306
MYSQL_DATABASE=arquitectura_db
MYSQL_USER=MONSTER
MYSQL_PASSWORD=MONSTER9
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_USE_SSL=false
# Use una clave distinta, secreta y de al menos 32 caracteres fuera de desarrollo.
JWT_SECRETO=cambia-esta-clave-local-por-una-de-mas-de-32-caracteres
