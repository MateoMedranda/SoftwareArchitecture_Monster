<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ink">

    <ScrollView android:id="@+id/loginScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="26dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="96dp">
                    <ImageView android:id="@+id/logo" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:contentDescription="Logo EUREKABANK"/>
                    <TextView android:id="@+id/logoFallback" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="◆" android:textColor="@color/cyan" android:textSize="58sp"/>
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="EUREKABANK" android:textColor="@color/text" android:textSize="25sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="25dp" android:gravity="center" android:text="Tu banca, siempre contigo" android:textColor="@color/muted" android:textSize="14sp"/>
                <EditText android:id="@+id/userInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_field" android:hint="Usuario" android:inputType="text" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_field" android:hint="Contraseña" android:inputType="textPassword" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <TextView android:id="@+id/loginStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/danger"/>
                <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_primary" android:text="Ingresar a mi banca" android:textColor="@color/ink" android:textStyle="bold"/>
                <TextView android:id="@+id/serverConfigButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="10dp" android:padding="5dp" android:text="Servidor" android:textColor="@color/muted" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/dashboardScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EUREKABANK" android:textColor="@color/cyan" android:textSize="19sp" android:textStyle="bold"/>
                <Button android:id="@+id/logoutButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salir"/>
            </LinearLayout>
            <TextView android:id="@+id/welcomeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="Tu resumen financiero" android:textColor="@color/muted" android:textSize="16sp"/>
            <LinearLayout android:id="@+id/accountsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <Button android:id="@+id/refreshButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="↻ Actualizar saldos"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transferir dinero" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
                <EditText android:id="@+id/originInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_field" android:hint="Cuenta origen" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <EditText android:id="@+id/destinationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:hint="Cuenta destino" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <EditText android:id="@+id/amountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:hint="Monto" android:inputType="numberDecimal" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <Button android:id="@+id/transferButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_primary" android:text="Confirmar transferencia" android:textColor="@color/ink"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Movimientos" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
                <EditText android:id="@+id/historyAccountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_field" android:hint="Número de cuenta" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <Button android:id="@+id/historyButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consultar historial"/>
                <TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mi perfil" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
                <Button android:id="@+id/profileButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consultar mi perfil"/>
                <TextView android:id="@+id/profileText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:textColor="@color/muted"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/administrationPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crear cuenta" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Selecciona al titular; el número único se genera automáticamente." android:textColor="@color/muted"/>
                <Button android:id="@+id/loadClientsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cargar clientes"/>
                <Spinner android:id="@+id/clientSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field"/>
                <Button android:id="@+id/createAccountButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_primary" android:enabled="false" android:text="Crear y asignar cuenta" android:textColor="@color/ink"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Operaciones y reversas" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disponibles según el rol de la sesión." android:textColor="@color/muted"/>
                <Spinner android:id="@+id/operationTypeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_field"/>
                <EditText android:id="@+id/operationAccountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:hint="Número de cuenta" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <EditText android:id="@+id/operationAmountInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_field" android:hint="Monto" android:inputType="numberDecimal" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <Button android:id="@+id/operationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Registrar operación"/>
                <EditText android:id="@+id/reverseIdInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_field" android:hint="ID de transacción para reversar" android:textColor="@color/text" android:textColorHint="@color/muted"/>
                <Button android:id="@+id/reverseButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reversar movimiento"/>
            </LinearLayout>
            <TextView android:id="@+id/dashboardStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:textColor="@color/cyan"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
