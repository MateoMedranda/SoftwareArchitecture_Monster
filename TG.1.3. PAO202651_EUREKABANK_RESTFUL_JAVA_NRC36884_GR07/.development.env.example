# Copie este archivo como .development.env y reemplace los valores de ejemplo.
# No suba .development.env al control de versiones.

# Conexión que usa EUREKABANK-RESTFUL (Payara / MySQL).
MYSQL_HOST=localhost
MYSQL_PUERTO=3306
MYSQL_DATABASE=eurekabank
MYSQL_USER=CAMBIAR_USUARIO
MYSQL_PASSWORD=CAMBIAR_CONTRASENA
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_USE_SSL=false

# Debe tener al menos 32 caracteres y ser único por ambiente.
JWT_SECRETO=CAMBIAR_POR_UN_SECRETO_LARGO_UNICO_DE_AL_MENOS_32_CARACTERES

# URL completa de la API REST para clientes Java. En Docker expuesto al host:
EUREKABANK_URL=http://localhost:9080/EUREKABANK-RESTFUL/api
