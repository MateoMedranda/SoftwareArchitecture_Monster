<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Identidad visual MONSTER (Azul) -->
    <SolidColorBrush x:Key="PincelPrimario" Color="#0D47A1" />
    <SolidColorBrush x:Key="PincelPrimarioClaro" Color="#1565C0" />
    <SolidColorBrush x:Key="PincelPrimarioOscuro" Color="#002171" />
    <SolidColorBrush x:Key="PincelFondo" Color="#F8FAFF" />
    <SolidColorBrush x:Key="PincelTarjeta" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PincelBorde" Color="#DCE3F0" />
    <SolidColorBrush x:Key="PincelTexto" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PincelTextoSecundario" Color="#455A64" />

    <!-- Mensajes -->
    <SolidColorBrush x:Key="PincelErrorFondo" Color="#FFEBEE" />
    <SolidColorBrush x:Key="PincelErrorTexto" Color="#C62828" />
    <SolidColorBrush x:Key="PincelAvisoFondo" Color="#FFF8E1" />
    <SolidColorBrush x:Key="PincelAvisoTexto" Color="#EF6C00" />
    <SolidColorBrush x:Key="PincelExitoFondo" Color="#E8F5E9" />
    <SolidColorBrush x:Key="PincelExitoTexto" Color="#2E7D32" />

    <Style x:Key="TituloVista" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelPrimarioOscuro}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="SubtituloVista" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSecundario}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSecundario}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CampoTexto" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="CampoContrasena" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="CampoSeleccion" TargetType="ComboBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Height" Value="34" />
    </Style>

    <Style x:Key="BotonPrincipal" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PincelPrimario}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="Background"
                                    Value="{StaticResource PincelPrimarioClaro}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Marco" Property="Background"
                                    Value="{StaticResource PincelPrimarioOscuro}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Marco" Property="Background" Value="#BDBDBD" />
                            <Setter Property="Foreground" Value="#EEEEEE" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource PincelPrimario}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Marco"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource PincelPrimarioClaro}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Marco" Property="Background" Value="#E8F1FF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9E9E9E" />
                            <Setter TargetName="Marco" Property="BorderBrush" Value="#BDBDBD" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
