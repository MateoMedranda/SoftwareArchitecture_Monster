# .env
# --- Servidor RESTFUL (Payara en Docker) ---
RESTFUL_HOST=localhost
RESTFUL_PORT=8181
RESTFUL_PROTOCOL=https
RESTFUL_CONTEXT=/WS_CON_UNI_JAVA_RESTFUL
RESTFUL_SERVICE=WSConversorUnidades

# Namespace del servicio (targetNamespace del WSDL)
RESTFUL_TARGET_NAMESPACE=http://ws.monster.edu.ec/

# Credenciales para login/cambiarContrasenia
RESTFUL_USER=MONSTER
RESTFUL_PASSWORD=MONSTER9

# Timeouts (ms)
RESTFUL_CONNECT_TIMEOUT=10000
RESTFUL_READ_TIMEOUT=30000

# Seguridad TLS (porque usas https con cert autofirmado en local)
RESTFUL_INSECURE_TLS=true

# JWT
jwt_secret=asdjdas-5as4fasg-kczcasd-hsdf4htr754sfda-sdafae755-asf455658
jwt_expiration=3600000